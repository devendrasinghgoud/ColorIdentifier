---
import { VEHICLE_TEMPLATES } from '../data/vehicleTemplates';

interface Props {
  initialType?: 'car' | 'bike';
  title?: string;
  subtitle?: string;
}

const {
  initialType = 'car',
  title = 'Vehicle Color Customizer Studio',
  subtitle = 'Preview and test any paint shade on cars and motorcycles. Choose factory templates or upload your vehicle photo.'
} = Astro.props;

const presetColors = [
  { name: 'Ultra Indigo', hex: '#6C5CE7' },
  { name: 'Hyper Violet', hex: '#8B5CF6' },
  { name: 'Cyan Streak', hex: '#22D3EE' },
  { name: 'Daytona Blue', hex: '#0E3A75' },
  { name: 'Monza Red', hex: '#D40026' },
  { name: 'Speed Yellow', hex: '#FFBF00' },
  { name: 'British Racing Green', hex: '#004225' },
  { name: 'Nardo Gray', hex: '#6B7280' },
  { name: 'Obsidian Black', hex: '#111827' },
  { name: 'Pearl White', hex: '#F8FAFC' }
];

const cars = VEHICLE_TEMPLATES.filter((t) => t.type === 'car');
const bikes = VEHICLE_TEMPLATES.filter((t) => t.type === 'bike');
---

<section class="card" style="padding: 24px; margin: 32px 0;">
  <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:16px; margin-bottom:20px;">
    <div>
      <h2 style="font-size:22px; margin:0 0 6px;">{title}</h2>
      <p style="color:var(--muted); font-size:14px; margin:0;">{subtitle}</p>
    </div>

    <!-- Step 1: Type Selection Switch -->
    <div style="display:flex; gap:8px;">
      <button
        id="btn-type-car"
        class={`button ${initialType === 'car' ? 'button-primary' : 'button-secondary'}`}
        type="button"
      >
        🚗 Car Studio
      </button>
      <button
        id="btn-type-bike"
        class={`button ${initialType === 'bike' ? 'button-primary' : 'button-secondary'}`}
        type="button"
      >
        🏍️ Bike Studio
      </button>
      <a href="/3d-vehicle-customizer/" class="button button-quiet" title="Open Interactive 3D WebGL Configurator">
        🎮 3D Studio &rarr;
      </a>
    </div>
  </div>

  <!-- Step 2: Vehicle Template Selection Carousel / Grid -->
  <div style="margin-bottom:20px;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
      <span style="font-size:12px; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:0.04em;">
        SELECT VEHICLE TEMPLATE OR UPLOAD PHOTO
      </span>
      <label class="button button-small button-secondary" style="cursor:pointer; display:inline-flex; align-items:center; gap:6px;">
        <span>📷 Upload Vehicle Photo</span>
        <input type="file" id="vehicle-photo-upload" accept="image/*" style="display:none;" />
      </label>
    </div>

    <div id="template-pill-list" style="display:flex; gap:8px; overflow-x:auto; padding-bottom:8px; scrollbar-width:thin;">
      {cars.map((tmpl, idx) => (
        <button
          class={`button button-small tmpl-btn ${idx === 0 && initialType === 'car' ? 'button-primary' : 'button-secondary'}`}
          data-id={tmpl.id}
          data-type="car"
          type="button"
          style={initialType === 'car' ? '' : 'display:none;'}
        >
          {tmpl.name}
        </button>
      ))}
      {bikes.map((tmpl, idx) => (
        <button
          class={`button button-small tmpl-btn ${idx === 0 && initialType === 'bike' ? 'button-primary' : 'button-secondary'}`}
          data-id={tmpl.id}
          data-type="bike"
          type="button"
          style={initialType === 'bike' ? '' : 'display:none;'}
        >
          {tmpl.name}
        </button>
      ))}
    </div>
  </div>

  <!-- Main Vehicle Customizer Canvas / SVG Viewport -->
  <div style="position:relative; background:var(--surface-elevated); border:1px solid var(--border); border-radius:16px; padding:24px; min-height:360px; display:flex; align-items:center; justify-content:center; overflow:hidden;">
    <div style="position:absolute; top:12px; right:12px; z-index:10; display:flex; gap:6px;">
      <button id="btn-use-template" class="button button-small button-quiet" type="button" style="display:none;">
        &larr; Back to Templates
      </button>
    </div>

    <!-- Scalable Vector Vehicle Template Renderer -->
    <div id="template-viewport" style="width:100%; max-width:880px; margin:auto; display:flex; justify-content:center; align-items:center;">
      <svg id="vehicle-svg" viewBox="0 0 900 360" style="width:100%; height:auto; max-height:420px; filter:drop-shadow(0 12px 28px rgba(0,0,0,0.15)); user-select:none;">
        <defs>
          <clipPath id="split-clip-left">
            <rect id="clip-rect-left" x="0" y="0" width="0" height="450" />
          </clipPath>
          <clipPath id="split-clip-right">
            <rect id="clip-rect-right" x="0" y="0" width="900" height="450" />
          </clipPath>
          <linearGradient id="rim-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#E2E8F0" />
            <stop offset="50%" stop-color="#94A3B8" />
            <stop offset="100%" stop-color="#475569" />
          </linearGradient>
          <linearGradient id="tire-grad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#1E293B" />
            <stop offset="100%" stop-color="#090B0E" />
          </linearGradient>
          <linearGradient id="glass-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="rgba(219, 234, 254, 0.85)" />
            <stop offset="50%" stop-color="rgba(147, 197, 253, 0.65)" />
            <stop offset="100%" stop-color="rgba(30, 58, 138, 0.75)" />
          </linearGradient>
          <linearGradient id="metallic-flake" x1="0%" y1="0%" x2="100%" y2="50%">
            <stop offset="0%" stop-color="rgba(255,255,255,0.3)" />
            <stop offset="25%" stop-color="rgba(255,255,255,0)" />
            <stop offset="50%" stop-color="rgba(255,255,255,0.4)" />
            <stop offset="75%" stop-color="rgba(255,255,255,0)" />
            <stop offset="100%" stop-color="rgba(255,255,255,0.25)" />
          </linearGradient>
          <linearGradient id="body-highlight" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="rgba(255,255,255,0.35)" />
            <stop offset="45%" stop-color="rgba(255,255,255,0.05)" />
            <stop offset="85%" stop-color="rgba(0,0,0,0.25)" />
            <stop offset="100%" stop-color="rgba(0,0,0,0.55)" />
          </linearGradient>
        </defs>

        <g id="svg-shadow-layer"></g>
        <!-- Original base body layer for split comparison -->
        <g id="svg-body-layer-orig" clip-path="url(#split-clip-left)"></g>
        <!-- Recolored multi-panel body layer -->
        <g id="svg-body-layer" clip-path="url(#split-clip-right)"></g>
        <g id="svg-finish-overlay" style="mix-blend-mode:overlay;pointer-events:none;"></g>
        <g id="svg-highlight-layer" style="mix-blend-mode:screen;pointer-events:none;"></g>
        <g id="svg-glass-layer"></g>
        <g id="svg-wheel-layer"></g>
        <g id="svg-trim-layer"></g>
        <!-- Split line indicator -->
        <line id="svg-split-line" x1="900" y1="0" x2="900" y2="360" stroke="#22D3EE" stroke-width="2" stroke-dasharray="4" style="display:none;" />
      </svg>
    </div>

    <!-- User Upload Canvas Renderer -->
    <div id="upload-viewport" style="display:none;width:100%;max-width:880px;position:relative;margin:auto;overflow:hidden;border-radius:12px;">
      <canvas id="photo-canvas" style="display:block;width:100%;height:auto;cursor:crosshair;box-shadow:0 8px 24px rgba(0,0,0,0.15);touch-action:none;"></canvas>
      <div id="brush-cursor" style="position:absolute;pointer-events:none;border:1.5px solid var(--brand-cyan);border-radius:50%;display:none;transform:translate(-50%,-50%);box-shadow:0 0 6px rgba(0,0,0,0.4);z-index:25;"></div>
    </div>
  </div>

  <!-- Interactive Before / After Split Slider & Zoom Controls -->
  <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:10px 16px;margin:14px 0;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
    <div style="display:flex;align-items:center;gap:10px;flex:1;min-width:260px;">
      <span style="font-size:12px;font-weight:700;white-space:nowrap;">Before / After Split:</span>
      <input id="split-slider" type="range" min="0" max="100" value="100" style="flex:1;accent-color:var(--brand-cyan);" />
      <span id="split-label" style="font-size:11px;color:var(--muted);min-width:70px;">100% Recolor</span>
    </div>
    <div style="display:flex;gap:8px;align-items:center;">
      <button id="btn-peek-original" class="button button-small button-quiet" type="button" title="Hold down to preview original vehicle color">
        👁️ Hold for Original
      </button>
      <button id="btn-zoom-in" class="button button-small button-secondary" type="button" title="Zoom in">+ Zoom</button>
      <button id="btn-zoom-out" class="button button-small button-secondary" type="button" title="Zoom out">- Zoom</button>
    </div>
  </div>

  <!-- Independent Body Panel Selector for Vector Templates -->
  <div id="panel-picker-container" style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:12px 16px;margin:14px 0;">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:10px;">
      <div style="display:flex;align-items:center;gap:8px;">
        <span style="font-size:12px;font-weight:700;">Select Body Panel to Customize:</span>
        <span id="selected-panel-badge" style="font-size:11px;font-weight:700;color:var(--brand-cyan);background:rgba(34,211,238,0.12);padding:3px 10px;border-radius:6px;border:1px solid rgba(34,211,238,0.3);">
          Editing: Bonnet / Hood
        </span>
      </div>
      <div style="display:flex;gap:6px;">
        <button id="btn-reset-panel" class="button button-small button-quiet" type="button" title="Reset selected panel back to default">
          ↺ Reset This Panel
        </button>
        <button id="btn-undo-panel" class="button button-small button-quiet" type="button" title="Undo panel change">
          ↶ Undo
        </button>
        <button id="btn-redo-panel" class="button button-small button-quiet" type="button" title="Redo panel change">
          ↷ Redo
        </button>
      </div>
    </div>
    <div id="panel-chips-list" style="display:flex;gap:8px;overflow-x:auto;padding-bottom:4px;scrollbar-width:thin;">
      <!-- Populated dynamically per vehicle template -->
    </div>
  </div>

  <!-- Manual Brush Tools (Shown only for uploaded photos) -->
  <div id="brush-controls" style="display:none;background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:12px 16px;margin:14px 0;">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <span style="font-size:12px;font-weight:700;">Selection:</span>
        <button id="tool-brush" class="button button-small button-primary" type="button">🖌️ Paint Panels</button>
        <button id="tool-eraser" class="button button-small button-secondary" type="button">🧹 Erase Mask</button>
        <label style="display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;margin-left:4px;cursor:pointer;">
          <input type="checkbox" id="chk-show-mask" checked />
          <span>Show Mask Highlight</span>
        </label>
      </div>
      <div style="display:flex;gap:10px;align-items:center;">
        <label for="brush-size" style="font-size:12px;font-weight:700;">Brush Size:</label>
        <input id="brush-size" type="range" min="5" max="70" value="25" style="accent-color:var(--brand-indigo);" />
        <span id="brush-size-val" style="font-size:12px;color:var(--muted);min-width:32px;">25px</span>
      </div>
      <div style="display:flex;gap:6px;">
        <button id="btn-undo" class="button button-small button-quiet" type="button" title="Undo stroke">↶ Undo</button>
        <button id="btn-redo" class="button button-small button-quiet" type="button" title="Redo stroke">↷ Redo</button>
        <button id="btn-clear-mask" class="button button-small button-quiet" type="button" style="color:var(--danger)">Clear Mask</button>
      </div>
    </div>
    <p class="privacy-hint" style="margin:8px 0 0;">
      Manual Brush: Paint over vehicle body panels. Windows, tires, and headlights remain unpainted. Toggle "Show Mask Highlight" to inspect your boundaries.
    </p>
  </div>

  <!-- Step 3 & 4: Color Picker & Finish Controls -->
  <div style="margin-top:20px;border-top:1px solid var(--border);padding-top:16px;">
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));gap:20px;">
      <!-- Color Picker -->
      <div>
        <label for="custom-hex-input" style="display:block;font-size:12px;font-weight:700;margin-bottom:8px;">
          <span id="picker-label-target">Panel Color</span> (HEX / Native Picker):
        </label>
        <div style="display:flex;gap:10px;align-items:center;margin-bottom:12px;">
          <input id="custom-color-picker" type="color" value="#3B82F6" style="width:54px;height:45px;padding:2px;border-radius:10px;cursor:pointer;" />
          <input id="custom-hex-input" value="#3B82F6" placeholder="#3B82F6" style="font-family:monospace;font-weight:700;" />
          <button id="btn-copy-color" class="button button-secondary button-small" type="button">Copy HEX</button>
        </div>

        <span style="display:block;font-size:11px;font-weight:700;color:var(--muted);margin-bottom:6px;">PRESET POPULAR AUTOMOTIVE SHADES</span>
        <div style="display:flex;gap:6px;flex-wrap:wrap;">
          {presetColors.map((p) => (
            <button
              class="preset-color-btn"
              data-hex={p.hex}
              title={`${p.name} (${p.hex})`}
              type="button"
              style={`width:30px;height:30px;border-radius:8px;background:${p.hex};border:1px solid var(--border);cursor:pointer;`}
            />
          ))}
        </div>
      </div>

      <!-- Finish & Tuning Sliders -->
      <div>
        <span style="display:block;font-size:12px;font-weight:700;margin-bottom:8px;">Paint Finish Simulation:</span>
        <div style="display:grid;grid-template-columns:repeat(4, 1fr);gap:6px;margin-bottom:14px;">
          <button class="button button-small button-primary finish-btn" data-finish="glossy" type="button">Glossy</button>
          <button class="button button-small button-secondary finish-btn" data-finish="metallic" type="button">Metallic</button>
          <button class="button button-small button-secondary finish-btn" data-finish="matte" type="button">Matte</button>
          <button class="button button-small button-secondary finish-btn" data-finish="satin" type="button">Satin</button>
        </div>

        <div style="display:grid;gap:10px;">
          <div>
            <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin-bottom:2px;">
              <span>Color Saturation (Intensity)</span>
              <span id="intensity-val">100%</span>
            </div>
            <input id="slider-intensity" type="range" min="30" max="170" value="100" style="width:100%;accent-color:var(--brand-indigo);" />
          </div>
          <div>
            <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin-bottom:2px;">
              <span>Panel Brightness Offset</span>
              <span id="brightness-val">0%</span>
            </div>
            <input id="slider-brightness" type="range" min="-40" max="40" value="0" style="width:100%;accent-color:var(--brand-indigo);" />
          </div>
        </div>
      </div>
    </div>

    <!-- Actions & Download -->
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-top:20px;border-top:1px solid var(--border);padding-top:14px;">
      <div style="display:flex;gap:10px;align-items:center;">
        <button id="btn-reset-all" class="button button-quiet button-small" type="button">Reset Entire Vehicle</button>
        <button id="btn-share-custom" class="button button-secondary button-small" type="button">Share Build</button>
      </div>
      <div style="display:flex;gap:10px;">
        <button id="btn-download-png" class="button button-primary" type="button">
          📥 Download Vehicle Image (PNG)
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  :global(.panel-chip) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 700;
    color: var(--ink);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }
  :global(.panel-chip:hover) {
    border-color: var(--brand-indigo);
  }
  :global(.panel-chip.is-active) {
    background: var(--surface-tint);
    border-color: var(--brand-cyan);
    color: var(--brand-indigo);
    box-shadow: 0 0 6px rgba(34, 211, 238, 0.35);
  }
  :global(.panel-chip-dot) {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
    border: 1px solid rgba(0,0,0,0.25);
  }
  :global(.vehicle-panel-svg) {
    cursor: pointer;
    transition: fill 0.15s ease, stroke 0.15s ease, filter 0.15s ease;
  }
  :global(.vehicle-panel-svg:hover) {
    filter: brightness(1.1);
  }
  :global(.vehicle-panel-svg.is-selected) {
    filter: drop-shadow(0 0 5px rgba(34, 211, 238, 0.85));
  }
</style>

<script>
  import { VEHICLE_TEMPLATES, type VehicleTemplate } from '../data/vehicleTemplates';
  import { parseHex, rgbToHsl, hslToRgb, rgbToHex } from '../lib/color';

  interface PanelState {
    color: string;
    finish: 'glossy' | 'metallic' | 'matte' | 'satin';
  }

  interface VehicleConfig {
    vehicleId: string;
    regions: Record<string, PanelState>;
  }

  let currentType: 'car' | 'bike' = 'car';
  let currentTemplate: VehicleTemplate = VEHICLE_TEMPLATES[0];
  let selectedPanelId: string = currentTemplate.panels[0]?.id || 'bonnet';

  // Per-vehicle configuration storage
  const vehicleConfigurations: Record<string, VehicleConfig> = {};

  // Undo / Redo for panels
  const panelUndoStack: string[] = [];
  const panelRedoStack: string[] = [];

  let intensity = 1.0;
  let brightness = 0;
  let isCustomPhoto = false;
  let splitPercent = 100;
  let zoomLevel = 1.0;
  let showMaskOverlay = true;

  // DOM Elements
  const typeCarBtn = document.querySelector<HTMLButtonElement>('#btn-type-car');
  const typeBikeBtn = document.querySelector<HTMLButtonElement>('#btn-type-bike');
  const templateBtns = document.querySelectorAll<HTMLButtonElement>('.tmpl-btn');
  const backToTemplateBtn = document.querySelector<HTMLButtonElement>('#btn-use-template');
  const photoUpload = document.querySelector<HTMLInputElement>('#vehicle-photo-upload');

  const templateViewport = document.querySelector<HTMLElement>('#template-viewport');
  const uploadViewport = document.querySelector<HTMLElement>('#upload-viewport');
  const brushControls = document.querySelector<HTMLElement>('#brush-controls');
  const panelPickerContainer = document.querySelector<HTMLElement>('#panel-picker-container');
  const panelChipsList = document.querySelector<HTMLElement>('#panel-chips-list');
  const selectedPanelBadge = document.querySelector<HTMLElement>('#selected-panel-badge');
  const btnResetPanel = document.querySelector<HTMLButtonElement>('#btn-reset-panel');
  const btnUndoPanel = document.querySelector<HTMLButtonElement>('#btn-undo-panel');
  const btnRedoPanel = document.querySelector<HTMLButtonElement>('#btn-redo-panel');
  const pickerLabelTarget = document.querySelector<HTMLElement>('#picker-label-target');

  const svg = document.querySelector<SVGElement>('#vehicle-svg');
  const shadowLayer = document.querySelector<SVGGElement>('#svg-shadow-layer');
  const bodyLayer = document.querySelector<SVGGElement>('#svg-body-layer');
  const bodyLayerOrig = document.querySelector<SVGGElement>('#svg-body-layer-orig');
  const clipRectLeft = document.querySelector<SVGRectElement>('#clip-rect-left');
  const clipRectRight = document.querySelector<SVGRectElement>('#clip-rect-right');
  const svgSplitLine = document.querySelector<SVGLineElement>('#svg-split-line');

  const finishOverlay = document.querySelector<SVGGElement>('#svg-finish-overlay');
  const highlightLayer = document.querySelector<SVGGElement>('#svg-highlight-layer');
  const glassLayer = document.querySelector<SVGGElement>('#svg-glass-layer');
  const wheelLayer = document.querySelector<SVGGElement>('#svg-wheel-layer');
  const trimLayer = document.querySelector<SVGGElement>('#svg-trim-layer');

  const splitSlider = document.querySelector<HTMLInputElement>('#split-slider');
  const splitLabel = document.querySelector<HTMLElement>('#split-label');
  const btnPeek = document.querySelector<HTMLButtonElement>('#btn-peek-original');
  const btnZoomIn = document.querySelector<HTMLButtonElement>('#btn-zoom-in');
  const btnZoomOut = document.querySelector<HTMLButtonElement>('#btn-zoom-out');

  const colorPicker = document.querySelector<HTMLInputElement>('#custom-color-picker');
  const hexInput = document.querySelector<HTMLInputElement>('#custom-hex-input');
  const copyColorBtn = document.querySelector<HTMLButtonElement>('#btn-copy-color');
  const finishBtns = document.querySelectorAll<HTMLButtonElement>('.finish-btn');
  const presetBtns = document.querySelectorAll<HTMLButtonElement>('.preset-color-btn');

  const sliderIntensity = document.querySelector<HTMLInputElement>('#slider-intensity');
  const sliderBrightness = document.querySelector<HTMLInputElement>('#slider-brightness');
  const intensityVal = document.querySelector<HTMLElement>('#intensity-val');
  const brightnessVal = document.querySelector<HTMLElement>('#brightness-val');

  const btnReset = document.querySelector<HTMLButtonElement>('#btn-reset-all');
  const btnShare = document.querySelector<HTMLButtonElement>('#btn-share-custom');
  const btnDownload = document.querySelector<HTMLButtonElement>('#btn-download-png');

  // Canvas & Brush Elements for Photo Upload
  const canvas = document.querySelector<HTMLCanvasElement>('#photo-canvas');
  const ctx = canvas?.getContext('2d', { willReadFrequently: true });
  const brushSizeSlider = document.querySelector<HTMLInputElement>('#brush-size');
  const brushSizeVal = document.querySelector<HTMLElement>('#brush-size-val');
  const toolBrushBtn = document.querySelector<HTMLButtonElement>('#tool-brush');
  const toolEraserBtn = document.querySelector<HTMLButtonElement>('#tool-eraser');
  const chkShowMask = document.querySelector<HTMLInputElement>('#chk-show-mask');
  const btnUndo = document.querySelector<HTMLButtonElement>('#btn-undo');
  const btnRedo = document.querySelector<HTMLButtonElement>('#btn-redo');
  const btnClearMask = document.querySelector<HTMLButtonElement>('#btn-clear-mask');
  const brushCursor = document.querySelector<HTMLElement>('#brush-cursor');

  let uploadedImg: HTMLImageElement | null = null;
  let maskCanvas: HTMLCanvasElement | null = null;
  let maskCtx: CanvasRenderingContext2D | null = null;
  let isDrawing = false;
  let lastX = 0;
  let lastY = 0;
  let brushMode: 'paint' | 'erase' = 'paint';
  let brushRadius = 25;
  let photoUndoStack: ImageData[] = [];
  let photoRedoStack: ImageData[] = [];

  // Helper: Get or Init configuration for current vehicle template
  function getVehicleConfig(vehicleId: string): VehicleConfig {
    if (!vehicleConfigurations[vehicleId]) {
      const saved = localStorage.getItem(`colorcode_vehicle_${vehicleId}`);
      if (saved) {
        try {
          vehicleConfigurations[vehicleId] = JSON.parse(saved);
        } catch (e) {}
      }
      if (!vehicleConfigurations[vehicleId]) {
        const tmpl = VEHICLE_TEMPLATES.find((t) => t.id === vehicleId) || currentTemplate;
        const regions: Record<string, PanelState> = {};
        tmpl.panels.forEach((p) => {
          regions[p.id] = {
            color: p.defaultColor || tmpl.defaultColor,
            finish: p.defaultFinish || 'glossy'
          };
        });
        vehicleConfigurations[vehicleId] = { vehicleId, regions };
      }
    }
    return vehicleConfigurations[vehicleId];
  }

  function recordPanelState() {
    const cfg = getVehicleConfig(currentTemplate.id);
    panelUndoStack.push(JSON.stringify(cfg.regions));
    if (panelUndoStack.length > 25) panelUndoStack.shift();
    panelRedoStack.length = 0;
  }

  // Check URL query parameters
  const urlParams = new URLSearchParams(window.location.search);
  const paramColor = urlParams.get('color');
  const paramType = urlParams.get('type');

  if (paramType === 'bike' || paramType === 'car') {
    currentType = paramType;
  }

  function setVehicleType(type: 'car' | 'bike') {
    currentType = type;
    if (typeCarBtn && typeBikeBtn) {
      typeCarBtn.classList.toggle('button-primary', type === 'car');
      typeCarBtn.classList.toggle('button-secondary', type !== 'car');
      typeBikeBtn.classList.toggle('button-primary', type === 'bike');
      typeBikeBtn.classList.toggle('button-secondary', type !== 'bike');
    }

    templateBtns.forEach((btn) => {
      const bType = btn.getAttribute('data-type');
      btn.style.display = bType === type ? '' : 'none';
    });

    const first = VEHICLE_TEMPLATES.find((t) => t.type === type);
    if (first) selectTemplate(first);
  }

  function selectTemplate(tmpl: VehicleTemplate) {
    currentTemplate = tmpl;
    isCustomPhoto = false;
    selectedPanelId = tmpl.panels[0]?.id || 'bonnet';

    if (templateViewport) templateViewport.style.display = 'flex';
    if (uploadViewport) uploadViewport.style.display = 'none';
    if (brushControls) brushControls.style.display = 'none';
    if (panelPickerContainer) panelPickerContainer.style.display = 'block';
    if (backToTemplateBtn) backToTemplateBtn.style.display = 'none';

    templateBtns.forEach((btn) => {
      const match = btn.getAttribute('data-id') === tmpl.id;
      btn.classList.toggle('button-primary', match);
      btn.classList.toggle('button-secondary', !match);
    });

    // If paramColor was passed, apply to initial panel
    if (paramColor && /^#?[0-9a-fA-F]{6}$/.test(paramColor)) {
      const hex = paramColor.startsWith('#') ? paramColor : '#' + paramColor;
      const cfg = getVehicleConfig(tmpl.id);
      if (cfg.regions[selectedPanelId]) {
        cfg.regions[selectedPanelId].color = hex;
      }
    }

    renderPanelChips();
    selectPanel(selectedPanelId);
    renderTemplate();
  }

  function renderPanelChips() {
    if (!panelChipsList) return;
    panelChipsList.innerHTML = '';

    const cfg = getVehicleConfig(currentTemplate.id);

    currentTemplate.panels.forEach((p) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = `panel-chip ${p.id === selectedPanelId ? 'is-active' : ''}`;
      btn.dataset.panelId = p.id;

      const pCfg = cfg.regions[p.id] || { color: currentTemplate.defaultColor, finish: 'glossy' };

      btn.innerHTML = `
        <span class="panel-chip-dot" style="background:${pCfg.color};"></span>
        <span>${p.name}</span>
      `;

      btn.addEventListener('click', () => {
        selectPanel(p.id);
      });

      panelChipsList.appendChild(btn);
    });
  }

  function selectPanel(panelId: string) {
    selectedPanelId = panelId;
    const cfg = getVehicleConfig(currentTemplate.id);
    const pCfg = cfg.regions[panelId] || { color: currentTemplate.defaultColor, finish: 'glossy' };
    const pDef = currentTemplate.panels.find((p) => p.id === panelId);

    if (selectedPanelBadge) {
      selectedPanelBadge.textContent = `Editing: ${pDef ? pDef.name : panelId}`;
    }
    if (pickerLabelTarget) {
      pickerLabelTarget.textContent = pDef ? pDef.name : 'Panel Color';
    }

    if (colorPicker) colorPicker.value = pCfg.color;
    if (hexInput) hexInput.value = pCfg.color;

    finishBtns.forEach((b) => {
      const f = b.getAttribute('data-finish');
      const active = f === pCfg.finish;
      b.classList.toggle('button-primary', active);
      b.classList.toggle('button-secondary', !active);
    });

    const chips = document.querySelectorAll<HTMLButtonElement>('.panel-chip');
    chips.forEach((c) => {
      c.classList.toggle('is-active', c.dataset.panelId === panelId);
    });

    renderTemplate();
  }

  function getCalculatedColor(baseHex: string): string {
    const rgb = parseHex(baseHex);
    if (!rgb) return baseHex;
    const hsl = rgbToHsl(rgb);
    const adjS = Math.max(0, Math.min(100, hsl.s * intensity));
    const adjL = Math.max(5, Math.min(95, hsl.l + brightness));
    return rgbToHex(hslToRgb({ h: hsl.h, s: adjS, l: adjL }));
  }

  function renderTemplate() {
    if (!svg || !bodyLayer || !shadowLayer || !glassLayer || !wheelLayer || !trimLayer) return;
    svg.setAttribute('viewBox', currentTemplate.viewBox);

    const cfg = getVehicleConfig(currentTemplate.id);
    const panels = currentTemplate.panels;

    // Split comparison calculations
    const vbMatch = currentTemplate.viewBox.split(' ');
    const vbWidth = Number(vbMatch[2]) || 900;
    const splitX = Math.round((splitPercent / 100) * vbWidth);

    if (clipRectLeft && clipRectRight) {
      clipRectLeft.setAttribute('width', String(vbWidth - splitX));
      clipRectRight.setAttribute('x', String(vbWidth - splitX));
      clipRectRight.setAttribute('width', String(splitX));
    }

    if (svgSplitLine) {
      if (splitPercent > 0 && splitPercent < 100) {
        svgSplitLine.style.display = '';
        svgSplitLine.setAttribute('x1', String(vbWidth - splitX));
        svgSplitLine.setAttribute('x2', String(vbWidth - splitX));
      } else {
        svgSplitLine.style.display = 'none';
      }
    }

    // Original body layer (left side of split)
    if (bodyLayerOrig) {
      bodyLayerOrig.innerHTML = panels
        .map((p) => `<path d="${p.d}" fill="${p.defaultColor || currentTemplate.defaultColor}" stroke="rgba(0,0,0,0.18)" stroke-width="2" />`)
        .join('');
    }

    // Independent multi-panel recolored body layer (right side of split)
    bodyLayer.innerHTML = panels
      .map((p) => {
        const pCfg = cfg.regions[p.id] || { color: currentTemplate.defaultColor, finish: 'glossy' };
        const calcCol = getCalculatedColor(pCfg.color);
        const isSelected = p.id === selectedPanelId;
        const strokeColor = isSelected ? '#22D3EE' : 'rgba(0,0,0,0.22)';
        const strokeWidth = isSelected ? '3.5' : '1.5';
        const filterAttr = isSelected ? 'filter: drop-shadow(0 0 5px rgba(34,211,238,0.85));' : '';
        return `<path d="${p.d}" data-panel-id="${p.id}" fill="${calcCol}" stroke="${strokeColor}" stroke-width="${strokeWidth}" style="cursor:pointer; transition: fill 0.15s ease, stroke 0.15s ease; ${filterAttr}" class="vehicle-panel-svg ${isSelected ? 'is-selected' : ''}" />`;
      })
      .join('');

    // Per-panel Finish Overlay Simulation
    if (finishOverlay) {
      finishOverlay.innerHTML = panels
        .map((p) => {
          const pCfg = cfg.regions[p.id] || { color: currentTemplate.defaultColor, finish: 'glossy' };
          if (pCfg.finish === 'metallic') {
            return `<path d="${p.d}" fill="url(#metallic-flake)" opacity="0.75" />`;
          } else if (pCfg.finish === 'satin') {
            return `<path d="${p.d}" fill="#FFFFFF" opacity="0.15" />`;
          } else if (pCfg.finish === 'matte') {
            return `<path d="${p.d}" fill="#000000" opacity="0.22" style="mix-blend-mode:multiply;" />`;
          }
          return '';
        })
        .join('');
    }

    // Highlights & Shadows
    if (highlightLayer) {
      highlightLayer.innerHTML = panels
        .map((p) => {
          const pCfg = cfg.regions[p.id] || { color: currentTemplate.defaultColor, finish: 'glossy' };
          const op = pCfg.finish === 'matte' ? '0.2' : pCfg.finish === 'satin' ? '0.4' : '0.65';
          return `<path d="${p.d}" fill="url(#body-highlight)" opacity="${op}" />`;
        })
        .join('');
    }

    // Ground Shadow
    shadowLayer.innerHTML = currentTemplate.shadowPaths
      .map((d) => `<path d="${d}" fill="#000000" opacity="0.45" />`)
      .join('');

    // Glass & Windows
    glassLayer.innerHTML = currentTemplate.glassPaths
      .map((d) => `<path d="${d}" fill="url(#glass-grad)" stroke="#334155" stroke-width="2" />`)
      .join('');

    // Wheels & Tires
    wheelLayer.innerHTML = currentTemplate.wheelPaths
      .map(
        (d) =>
          `<path d="${d}" fill="url(#tire-grad)" stroke="#090B0E" stroke-width="3" />` +
          `<circle cx="${d.match(/M\s*([\d.]+)/)?.[1] || 0}" cy="275" r="24" fill="url(#rim-grad)" stroke="#1E293B" stroke-width="2" />`
      )
      .join('');

    // Chrome & Trim
    trimLayer.innerHTML = currentTemplate.trimPaths
      .map((d) => `<path d="${d}" fill="#CBD5E1" stroke="#64748B" stroke-width="1.5" />`)
      .join('');
  }

  // Direct SVG Panel Clicking Listener
  bodyLayer?.addEventListener('click', (e) => {
    const target = (e.target as SVGElement).closest<SVGPathElement>('[data-panel-id]');
    if (target) {
      const pId = target.getAttribute('data-panel-id');
      if (pId) {
        selectPanel(pId);
      }
    }
  });

  // Photo Upload and Manual Masking
  photoUpload?.addEventListener('change', () => {
    const file = photoUpload.files?.[0];
    if (!file) return;

    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      isCustomPhoto = true;
      uploadedImg = img;
      if (templateViewport) templateViewport.style.display = 'none';
      if (uploadViewport) uploadViewport.style.display = 'block';
      if (brushControls) brushControls.style.display = 'block';
      if (panelPickerContainer) panelPickerContainer.style.display = 'none';
      if (backToTemplateBtn) backToTemplateBtn.style.display = 'inline-flex';

      setupPhotoCanvas();
      URL.revokeObjectURL(url);
    };
    img.src = url;
  });

  backToTemplateBtn?.addEventListener('click', () => {
    selectTemplate(currentTemplate);
  });

  function setupPhotoCanvas() {
    if (!canvas || !ctx || !uploadedImg) return;
    const maxW = 900;
    const scale = Math.min(1, maxW / uploadedImg.naturalWidth);
    canvas.width = Math.round(uploadedImg.naturalWidth * scale);
    canvas.height = Math.round(uploadedImg.naturalHeight * scale);

    maskCanvas = document.createElement('canvas');
    maskCanvas.width = canvas.width;
    maskCanvas.height = canvas.height;
    maskCtx = maskCanvas.getContext('2d');

    photoUndoStack = [];
    photoRedoStack = [];
    saveMaskState();
    renderUserPhoto();
  }

  function saveMaskState() {
    if (!maskCtx || !maskCanvas) return;
    const data = maskCtx.getImageData(0, 0, maskCanvas.width, maskCanvas.height);
    photoUndoStack.push(data);
    if (photoUndoStack.length > 20) photoUndoStack.shift();
    photoRedoStack = [];
  }

  function paintBrushStroke(startX: number, startY: number, endX: number, endY: number) {
    if (!maskCtx) return;
    maskCtx.lineCap = 'round';
    maskCtx.lineJoin = 'round';
    maskCtx.lineWidth = brushRadius * 2;

    if (brushMode === 'paint') {
      maskCtx.globalCompositeOperation = 'source-over';
      maskCtx.strokeStyle = 'rgba(255, 255, 255, 1)';
    } else {
      maskCtx.globalCompositeOperation = 'destination-out';
      maskCtx.strokeStyle = 'rgba(0, 0, 0, 1)';
    }

    maskCtx.beginPath();
    maskCtx.moveTo(startX, startY);
    maskCtx.lineTo(endX, endY);
    maskCtx.stroke();

    renderUserPhoto();
  }

  function getCanvasCoords(clientX: number, clientY: number): { x: number; y: number } {
    if (!canvas) return { x: 0, y: 0 };
    const rect = canvas.getBoundingClientRect();
    const scaleX = canvas.width / rect.width;
    const scaleY = canvas.height / rect.height;
    return {
      x: (clientX - rect.left) * scaleX,
      y: (clientY - rect.top) * scaleY
    };
  }

  function renderUserPhoto() {
    if (!ctx || !canvas || !uploadedImg || !maskCanvas || !maskCtx) return;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.drawImage(uploadedImg, 0, 0, canvas.width, canvas.height);

    const activeColor = getCalculatedColor(colorPicker?.value || '#3B82F6');
    const splitX = Math.round((splitPercent / 100) * canvas.width);

    const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
    const maskData = maskCtx.getImageData(0, 0, canvas.width, canvas.height);
    const targetRgb = parseHex(activeColor) || { r: 59, g: 130, b: 246 };

    const pixels = imgData.data;
    const maskPixels = maskData.data;
    const w = canvas.width;
    const h = canvas.height;

    for (let y = 0; y < h; y++) {
      for (let x = 0; x < w; x++) {
        const idx = (y * w + x) * 4;
        const maskAlpha = maskPixels[idx + 3];

        if (maskAlpha > 15 && x >= (w - splitX)) {
          const r = pixels[idx];
          const g = pixels[idx + 1];
          const b = pixels[idx + 2];

          const lum = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
          const blendStrength = (maskAlpha / 255) * (lum > 0.85 ? Math.max(0.1, 1 - (lum - 0.85) * 4) : 1);

          let newR = targetRgb.r * lum;
          let newG = targetRgb.g * lum;
          let newB = targetRgb.b * lum;

          pixels[idx] = Math.round(r * (1 - blendStrength) + newR * blendStrength);
          pixels[idx + 1] = Math.round(g * (1 - blendStrength) + newG * blendStrength);
          pixels[idx + 2] = Math.round(b * (1 - blendStrength) + newB * blendStrength);
        }
      }
    }

    ctx.putImageData(imgData, 0, 0);

    // Mask boundary highlight
    if (showMaskOverlay && brushMode === 'paint') {
      ctx.save();
      ctx.globalAlpha = 0.22;
      ctx.fillStyle = '#22D3EE';
      ctx.drawImage(maskCanvas, 0, 0);
      ctx.restore();
    }
  }

  // Canvas Mouse / Touch Painting
  canvas?.addEventListener('mousedown', (e) => {
    isDrawing = true;
    const { x, y } = getCanvasCoords(e.clientX, e.clientY);
    lastX = x;
    lastY = y;
    paintBrushStroke(x, y, x, y);
  });

  window.addEventListener('mouseup', () => {
    if (isDrawing) {
      isDrawing = false;
      saveMaskState();
      renderUserPhoto();
    }
  });

  canvas?.addEventListener('mousemove', (e) => {
    const { x, y } = getCanvasCoords(e.clientX, e.clientY);

    if (brushCursor && canvas) {
      const rect = canvas.getBoundingClientRect();
      brushCursor.style.display = 'block';
      brushCursor.style.left = `${e.clientX}px`;
      brushCursor.style.top = `${e.clientY}px`;
      const screenRadius = brushRadius * (rect.width / canvas.width);
      brushCursor.style.width = `${screenRadius * 2}px`;
      brushCursor.style.height = `${screenRadius * 2}px`;
    }

    if (isDrawing) {
      paintBrushStroke(lastX, lastY, x, y);
      lastX = x;
      lastY = y;
    }
  });

  canvas?.addEventListener('mouseleave', () => {
    if (brushCursor) brushCursor.style.display = 'none';
  });

  canvas?.addEventListener('touchstart', (e) => {
    const t = e.touches[0];
    if (!t) return;
    e.preventDefault();
    isDrawing = true;
    const { x, y } = getCanvasCoords(t.clientX, t.clientY);
    lastX = x;
    lastY = y;
    paintBrushStroke(x, y, x, y);
  }, { passive: false });

  canvas?.addEventListener('touchmove', (e) => {
    const t = e.touches[0];
    if (!t || !isDrawing) return;
    e.preventDefault();
    const { x, y } = getCanvasCoords(t.clientX, t.clientY);
    paintBrushStroke(lastX, lastY, x, y);
    lastX = x;
    lastY = y;
  }, { passive: false });

  canvas?.addEventListener('touchend', (e) => {
    if (isDrawing) {
      e.preventDefault();
      isDrawing = false;
      saveMaskState();
      renderUserPhoto();
    }
  });

  toolBrushBtn?.addEventListener('click', () => {
    brushMode = 'paint';
    toolBrushBtn.classList.add('button-primary');
    toolBrushBtn.classList.remove('button-secondary');
    toolEraserBtn?.classList.add('button-secondary');
    toolEraserBtn?.classList.remove('button-primary');
  });

  toolEraserBtn?.addEventListener('click', () => {
    brushMode = 'erase';
    toolEraserBtn.classList.add('button-primary');
    toolEraserBtn.classList.remove('button-secondary');
    toolBrushBtn?.classList.add('button-secondary');
    toolBrushBtn?.classList.remove('button-primary');
  });

  chkShowMask?.addEventListener('change', () => {
    showMaskOverlay = chkShowMask.checked;
    renderUserPhoto();
  });

  brushSizeSlider?.addEventListener('input', () => {
    brushRadius = Number(brushSizeSlider.value);
    if (brushSizeVal) brushSizeVal.textContent = `${brushRadius}px`;
  });

  btnUndo?.addEventListener('click', () => {
    if (photoUndoStack.length > 1 && maskCtx && maskCanvas) {
      photoRedoStack.push(photoUndoStack.pop()!);
      const prev = photoUndoStack[photoUndoStack.length - 1];
      maskCtx.putImageData(prev, 0, 0);
      renderUserPhoto();
    }
  });

  btnRedo?.addEventListener('click', () => {
    if (photoRedoStack.length > 0 && maskCtx && maskCanvas) {
      const next = photoRedoStack.pop()!;
      photoUndoStack.push(next);
      maskCtx.putImageData(next, 0, 0);
      renderUserPhoto();
    }
  });

  btnClearMask?.addEventListener('click', () => {
    if (maskCtx && maskCanvas) {
      saveMaskState();
      maskCtx.clearRect(0, 0, maskCanvas.width, maskCanvas.height);
      renderUserPhoto();
    }
  });

  // Split Comparison Slider
  splitSlider?.addEventListener('input', () => {
    splitPercent = Number(splitSlider.value);
    if (splitLabel) {
      splitLabel.textContent = splitPercent === 100 ? '100% Recolor' : splitPercent === 0 ? 'Original' : `${splitPercent}% Split`;
    }
    if (isCustomPhoto) renderUserPhoto();
    else renderTemplate();
  });

  let prevSplit = 100;
  btnPeek?.addEventListener('mousedown', () => {
    prevSplit = splitPercent;
    splitPercent = 0;
    if (isCustomPhoto) renderUserPhoto();
    else renderTemplate();
  });
  window.addEventListener('mouseup', () => {
    if (splitPercent === 0 && prevSplit !== 0) {
      splitPercent = prevSplit;
      if (isCustomPhoto) renderUserPhoto();
      else renderTemplate();
    }
  });

  btnPeek?.addEventListener('touchstart', (e) => {
    e.preventDefault();
    prevSplit = splitPercent;
    splitPercent = 0;
    if (isCustomPhoto) renderUserPhoto();
    else renderTemplate();
  });
  btnPeek?.addEventListener('touchend', (e) => {
    e.preventDefault();
    splitPercent = prevSplit;
    if (isCustomPhoto) renderUserPhoto();
    else renderTemplate();
  });

  // Zoom Controls
  btnZoomIn?.addEventListener('click', () => {
    zoomLevel = Math.min(2.5, zoomLevel + 0.25);
    applyZoom();
  });
  btnZoomOut?.addEventListener('click', () => {
    zoomLevel = Math.max(1.0, zoomLevel - 0.25);
    applyZoom();
  });
  function applyZoom() {
    const target = isCustomPhoto ? canvas : svg;
    if (target) {
      target.style.transform = `scale(${zoomLevel})`;
      target.style.transformOrigin = 'center center';
      target.style.transition = 'transform 0.15s ease-out';
    }
  }

  // Type & Template Selection
  typeCarBtn?.addEventListener('click', () => setVehicleType('car'));
  typeBikeBtn?.addEventListener('click', () => setVehicleType('bike'));

  templateBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-id');
      const tmpl = VEHICLE_TEMPLATES.find((t) => t.id === id);
      if (tmpl) selectTemplate(tmpl);
    });
  });

  // Color & Finish Updates (Independent Per Panel)
  function updateActivePanelColor(hex: string) {
    if (isCustomPhoto) {
      if (colorPicker) colorPicker.value = hex;
      if (hexInput) hexInput.value = hex;
      renderUserPhoto();
      return;
    }

    recordPanelState();
    const cfg = getVehicleConfig(currentTemplate.id);
    if (!cfg.regions[selectedPanelId]) {
      cfg.regions[selectedPanelId] = { color: hex, finish: 'glossy' };
    } else {
      cfg.regions[selectedPanelId].color = hex;
    }

    if (colorPicker) colorPicker.value = hex;
    if (hexInput) hexInput.value = hex;

    // Update chip dot
    const chipDot = document.querySelector<HTMLElement>(`.panel-chip[data-panel-id="${selectedPanelId}"] .panel-chip-dot`);
    if (chipDot) chipDot.style.background = hex;

    localStorage.setItem(`colorcode_vehicle_${currentTemplate.id}`, JSON.stringify(cfg));
    renderTemplate();
  }

  function updateActivePanelFinish(finish: 'glossy' | 'metallic' | 'matte' | 'satin') {
    if (isCustomPhoto) {
      finishBtns.forEach((b) => {
        const active = b.getAttribute('data-finish') === finish;
        b.classList.toggle('button-primary', active);
        b.classList.toggle('button-secondary', !active);
      });
      renderUserPhoto();
      return;
    }

    recordPanelState();
    const cfg = getVehicleConfig(currentTemplate.id);
    if (!cfg.regions[selectedPanelId]) {
      cfg.regions[selectedPanelId] = { color: currentTemplate.defaultColor, finish };
    } else {
      cfg.regions[selectedPanelId].finish = finish;
    }

    finishBtns.forEach((b) => {
      const active = b.getAttribute('data-finish') === finish;
      b.classList.toggle('button-primary', active);
      b.classList.toggle('button-secondary', !active);
    });

    localStorage.setItem(`colorcode_vehicle_${currentTemplate.id}`, JSON.stringify(cfg));
    renderTemplate();
  }

  colorPicker?.addEventListener('input', () => updateActivePanelColor(colorPicker.value));
  hexInput?.addEventListener('input', () => {
    const p = parseHex(hexInput.value);
    if (p) updateActivePanelColor(hexInput.value.toUpperCase());
  });

  presetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const hx = btn.getAttribute('data-hex');
      if (hx) updateActivePanelColor(hx);
    });
  });

  finishBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const finish = (btn.getAttribute('data-finish') || 'glossy') as 'glossy' | 'metallic' | 'matte' | 'satin';
      updateActivePanelFinish(finish);
    });
  });

  sliderIntensity?.addEventListener('input', () => {
    intensity = Number(sliderIntensity.value) / 100;
    if (intensityVal) intensityVal.textContent = `${Math.round(intensity * 100)}%`;
    if (isCustomPhoto) renderUserPhoto();
    else renderTemplate();
  });

  sliderBrightness?.addEventListener('input', () => {
    brightness = Number(sliderBrightness.value);
    if (brightnessVal) brightnessVal.textContent = `${brightness > 0 ? '+' : ''}${brightness}%`;
    if (isCustomPhoto) renderUserPhoto();
    else renderTemplate();
  });

  copyColorBtn?.addEventListener('click', async () => {
    const hex = hexInput?.value || colorPicker?.value || '#3B82F6';
    try {
      await navigator.clipboard.writeText(hex);
      copyColorBtn.textContent = 'Copied!';
      setTimeout(() => { copyColorBtn.textContent = 'Copy HEX'; }, 1200);
    } catch {}
  });

  // Reset Active Panel Only
  btnResetPanel?.addEventListener('click', () => {
    if (isCustomPhoto) return;
    recordPanelState();
    const cfg = getVehicleConfig(currentTemplate.id);
    const pDef = currentTemplate.panels.find((p) => p.id === selectedPanelId);
    const defCol = pDef?.defaultColor || currentTemplate.defaultColor;
    const defFin = pDef?.defaultFinish || 'glossy';

    cfg.regions[selectedPanelId] = { color: defCol, finish: defFin };
    localStorage.setItem(`colorcode_vehicle_${currentTemplate.id}`, JSON.stringify(cfg));

    renderPanelChips();
    selectPanel(selectedPanelId);
    renderTemplate();
  });

  // Reset Entire Vehicle
  btnReset?.addEventListener('click', () => {
    if (isCustomPhoto) {
      if (canvas && ctx && uploadedImg) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(uploadedImg, 0, 0, canvas.width, canvas.height);
      }
      return;
    }

    recordPanelState();
    const cfg = getVehicleConfig(currentTemplate.id);
    currentTemplate.panels.forEach((p) => {
      cfg.regions[p.id] = {
        color: p.defaultColor || currentTemplate.defaultColor,
        finish: p.defaultFinish || 'glossy'
      };
    });

    localStorage.removeItem(`colorcode_vehicle_${currentTemplate.id}`);
    intensity = 1.0;
    brightness = 0;
    splitPercent = 100;
    zoomLevel = 1.0;
    applyZoom();

    if (splitSlider) splitSlider.value = '100';
    if (splitLabel) splitLabel.textContent = '100% Recolor';
    if (sliderIntensity) sliderIntensity.value = '100';
    if (sliderBrightness) sliderBrightness.value = '0';
    if (intensityVal) intensityVal.textContent = '100%';
    if (brightnessVal) brightnessVal.textContent = '0%';

    renderPanelChips();
    selectPanel(selectedPanelId);
    renderTemplate();
  });

  // Undo / Redo for Panels
  btnUndoPanel?.addEventListener('click', () => {
    if (panelUndoStack.length === 0) return;
    const cfg = getVehicleConfig(currentTemplate.id);
    panelRedoStack.push(JSON.stringify(cfg.regions));

    const prev = panelUndoStack.pop();
    if (prev) {
      cfg.regions = JSON.parse(prev);
      localStorage.setItem(`colorcode_vehicle_${currentTemplate.id}`, JSON.stringify(cfg));
      renderPanelChips();
      selectPanel(selectedPanelId);
      renderTemplate();
    }
  });

  btnRedoPanel?.addEventListener('click', () => {
    if (panelRedoStack.length === 0) return;
    const cfg = getVehicleConfig(currentTemplate.id);
    panelUndoStack.push(JSON.stringify(cfg.regions));

    const next = panelRedoStack.pop();
    if (next) {
      cfg.regions = JSON.parse(next);
      localStorage.setItem(`colorcode_vehicle_${currentTemplate.id}`, JSON.stringify(cfg));
      renderPanelChips();
      selectPanel(selectedPanelId);
      renderTemplate();
    }
  });

  btnShare?.addEventListener('click', async () => {
    const url = new URL(window.location.href);
    const cfg = getVehicleConfig(currentTemplate.id);
    url.searchParams.set('type', currentType);
    url.searchParams.set('color', cfg.regions[selectedPanelId]?.color || currentTemplate.defaultColor);
    try {
      await navigator.clipboard.writeText(url.toString());
      btnShare.textContent = 'Link Copied!';
      setTimeout(() => { btnShare.textContent = 'Share Build'; }, 1500);
    } catch {}
  });

  // PNG Export
  btnDownload?.addEventListener('click', () => {
    if (isCustomPhoto && canvas) {
      const dataUrl = canvas.toDataURL('image/png');
      const a = document.createElement('a');
      a.download = `customized-${currentType}.png`;
      a.href = dataUrl;
      a.click();
    } else if (svg) {
      const serializer = new XMLSerializer();
      let source = serializer.serializeToString(svg);

      if (!source.match(/^<svg[^>]+xmlns="http:\/\/www\.w3\.org\/2000\/svg"/)) {
        source = source.replace(/^<svg/, '<svg xmlns="http://www.w3.org/2000/svg"');
      }

      const svgBlob = new Blob([source], { type: 'image/svg+xml;charset=utf-8' });
      const DOMURL = window.URL || window.webkitURL || window;
      const url = DOMURL.createObjectURL(svgBlob);
      const img = new Image();

      img.onload = () => {
        const outCanvas = document.createElement('canvas');
        outCanvas.width = 1800;
        outCanvas.height = 720;
        const outCtx = outCanvas.getContext('2d');
        if (outCtx) {
          outCtx.fillStyle = '#0B1020';
          outCtx.fillRect(0, 0, outCanvas.width, outCanvas.height);
          outCtx.drawImage(img, 0, 0, outCanvas.width, outCanvas.height);
          const pngUrl = outCanvas.toDataURL('image/png');
          const a = document.createElement('a');
          a.download = `${currentTemplate.id}-customized.png`;
          a.href = pngUrl;
          a.click();
        }
        DOMURL.revokeObjectURL(url);
      };
      img.src = url;
    }
  });

  // Initial load
  setVehicleType(currentType);
</script>
