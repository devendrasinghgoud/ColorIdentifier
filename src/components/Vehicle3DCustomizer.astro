---
import { WORLDWIDE_VEHICLE_CATALOGUE, VEHICLE_CATEGORIES } from '../data/vehicleCatalogue';
import { VEHICLE_3D_ASSET_REGISTRY } from '../data/vehicleAssetRegistry';

interface Props {
  initialMarket?: string;
  initialManufacturer?: string;
  initialModel?: string;
  initialColor?: string;
}

const {
  initialMarket = 'IT',
  initialManufacturer = 'ferrari',
  initialModel = 'ferrari-458-italia',
  initialColor = '#DC2626'
} = Astro.props;

// Curated automotive paint preset palettes
const FACTORY_OEM_PALETTES = [
  { name: 'Rosso Corsa', hex: '#DC2626', finish: 'glossy' },
  { name: 'Daytona Blue', hex: '#1D4ED8', finish: 'metallic' },
  { name: 'British Racing Green', hex: '#064E3B', finish: 'glossy' },
  { name: 'Nardo Gray', hex: '#6B7280', finish: 'glossy' },
  { name: 'Championship White', hex: '#F9FAFB', finish: 'glossy' },
  { name: 'Monza Red', hex: '#EF4444', finish: 'glossy' },
  { name: 'Speed Yellow', hex: '#EAB308', finish: 'glossy' },
  { name: 'Miami Blue', hex: '#0EA5E9', finish: 'glossy' },
  { name: 'Austin Yellow', hex: '#CA8A04', finish: 'metallic' },
  { name: 'Silverstone Metallic', hex: '#94A3B8', finish: 'metallic' },
  { name: 'Midnight Purple', hex: '#4C1D95', finish: 'pearl' },
  { name: 'Carbon Black', hex: '#09090B', finish: 'metallic' }
];

const METALLIC_PEARL_PALETTES = [
  { name: 'Liquid Silver Metallic', hex: '#CBD5E1', finish: 'metallic' },
  { name: 'Mystic Blue Metallic', hex: '#2563EB', finish: 'metallic' },
  { name: 'Sunburst Gold Pearl', hex: '#F59E0B', finish: 'pearl' },
  { name: 'Emerald Jewel Pearl', hex: '#059669', finish: 'pearl' },
  { name: 'Ruby Star Metallic', hex: '#BE185D', finish: 'pearl' },
  { name: 'Deep Bronze Metallic', hex: '#78350F', finish: 'metallic' }
];

const SATIN_MATTE_PALETTES = [
  { name: 'Frozen Dark Gray', hex: '#374151', finish: 'satin' },
  { name: 'Stealth Black Matte', hex: '#18181B', finish: 'matte' },
  { name: 'Matte Military Olive', hex: '#3F6212', finish: 'matte' },
  { name: 'Satin Cyan Streak', hex: '#06B6D4', finish: 'satin' },
  { name: 'Matte Cashmere Silver', hex: '#A1A1AA', finish: 'matte' },
  { name: 'Frozen Marina Blue', hex: '#0284C7', finish: 'satin' }
];

const RIM_FINISH_PRESETS = [
  { id: 'silver', label: 'Machined Silver', hex: '#E2E8F0', roughness: 0.2, metalness: 0.9 },
  { id: 'black', label: 'Gloss Black', hex: '#0F172A', roughness: 0.15, metalness: 0.8 },
  { id: 'graphite', label: 'Dark Gunmetal', hex: '#334155', roughness: 0.3, metalness: 0.85 },
  { id: 'bronze', label: 'Satin Bronze', hex: '#B45309', roughness: 0.45, metalness: 0.7 },
  { id: 'champagne', label: 'Champagne Gold', hex: '#F59E0B', roughness: 0.35, metalness: 0.85 },
  { id: 'race-gold', label: 'Race Gold', hex: '#EAB308', roughness: 0.25, metalness: 0.9 }
];

const CALIPER_COLOR_PRESETS = [
  { id: 'brembo-red', label: 'Brembo Red', hex: '#DC2626' },
  { id: 'acid-green', label: 'Acid Green', hex: '#84CC16' },
  { id: 'racing-yellow', label: 'Racing Yellow', hex: '#EAB308' },
  { id: 'cyan-sport', label: 'Performance Cyan', hex: '#06B6D4' },
  { id: 'stealth-black', label: 'Stealth Black', hex: '#18181B' }
];
---

<div
  class="studio-root"
  id="studio-root"
  data-initial-market={initialMarket}
  data-initial-manufacturer={initialManufacturer}
  data-initial-model={initialModel}
  data-initial-color={initialColor}
>
  <!-- Serialized Catalogue and Asset Registry Data -->
  <script type="application/json" id="catalogue-data" set:html={JSON.stringify(WORLDWIDE_VEHICLE_CATALOGUE)} />
  <script type="application/json" id="asset-registry-data" set:html={JSON.stringify(VEHICLE_3D_ASSET_REGISTRY)} />

  <!-- Category Filter Pills Bar -->
  <nav class="category-filters-bar" aria-label="Vehicle Categories">
    <div class="category-scroll">
      <button class="cat-pill is-active" data-category="all" type="button">
        <span>🌐</span> All Categories
      </button>
      {VEHICLE_CATEGORIES.map((cat) => (
        <button class="cat-pill" data-category={cat.id} type="button">
          <span>{cat.icon}</span> {cat.label}
        </button>
      ))}
    </div>
  </nav>

  <!-- Main 3-Column Studio Layout -->
  <div class="studio-grid">
    <!-- ================================================================= -->
    <!-- LEFT SIDEBAR: Comprehensive Global Hierarchy Selectors & Specs -->
    <!-- ================================================================= -->
    <aside class="studio-sidebar sidebar-left">
      <div class="sidebar-header">
        <h3 class="sidebar-title">Vehicle Selection</h3>
        <span class="badge badge-indigo" id="badge-country-name">Worldwide</span>
      </div>

      <!-- Country / Market Selector -->
      <div class="form-group">
        <label for="select-country" class="form-label">Country / Market</label>
        <select id="select-country" class="form-select">
          <option value="ALL">All Worldwide Markets</option>
          {WORLDWIDE_VEHICLE_CATALOGUE.map((c) => (
            <option value={c.code} selected={c.code === initialMarket}>{c.name} ({c.region})</option>
          ))}
        </select>
      </div>

      <!-- Manufacturer Selector (with Quick Search) -->
      <div class="form-group">
        <div class="label-with-search">
          <label for="select-mfr" class="form-label">Manufacturer</label>
          <input type="text" id="input-search-mfr" class="form-search-mini" placeholder="Search brands..." />
        </div>
        <select id="select-mfr" class="form-select">
          <!-- Populated dynamically via JS -->
        </select>
      </div>

      <!-- Model Selector (with Quick Search) -->
      <div class="form-group">
        <div class="label-with-search">
          <label for="select-model" class="form-label">Model</label>
          <input type="text" id="input-search-model" class="form-search-mini" placeholder="Search models..." />
        </div>
        <select id="select-model" class="form-select">
          <!-- Populated dynamically via JS -->
        </select>
      </div>

      <!-- Generation Selector -->
      <div class="form-group">
        <label for="select-generation" class="form-label">Generation</label>
        <select id="select-generation" class="form-select">
          <!-- Populated dynamically via JS -->
        </select>
      </div>

      <!-- Model Year Selector -->
      <div class="form-group">
        <label for="select-year" class="form-label">Model Year</label>
        <select id="select-year" class="form-select">
          <!-- Populated dynamically via JS -->
        </select>
      </div>

      <!-- Variant / Trim Selector -->
      <div class="form-group">
        <label for="select-variant" class="form-label">Variant / Trim</label>
        <select id="select-variant" class="form-select">
          <!-- Populated dynamically via JS -->
        </select>
      </div>

      <!-- 3D Model Coverage Status Card -->
      <div class="card status-card" id="status-card">
        <div class="status-indicator-row">
          <span class="status-pulse-dot" id="status-dot"></span>
          <span class="status-title" id="status-title">Checking 3D Model Coverage...</span>
        </div>
        <p class="status-sub" id="status-desc">Verifying manufacturer licensing & CAD availability.</p>
        <div class="status-tags-row">
          <span class="badge" id="badge-drivetrain">Drivetrain: RWD</span>
          <span class="badge" id="badge-transmission">DCT</span>
        </div>
      </div>

      <!-- Technical Specifications Sheet -->
      <div class="card specs-card">
        <h4 class="specs-title">Technical Specifications</h4>
        <div class="spec-row">
          <span class="spec-label">Engine / Powertrain</span>
          <span class="spec-val" id="spec-engine">—</span>
        </div>
        <div class="spec-row">
          <span class="spec-label">Horsepower</span>
          <span class="spec-val" id="spec-power">—</span>
        </div>
        <div class="spec-row">
          <span class="spec-label">Torque</span>
          <span class="spec-val" id="spec-torque">—</span>
        </div>
        <div class="spec-row">
          <span class="spec-label">Transmission</span>
          <span class="spec-val" id="spec-trans">—</span>
        </div>
        <div class="spec-row">
          <span class="spec-label">Drivetrain</span>
          <span class="spec-val" id="spec-drive">—</span>
        </div>
      </div>

      <!-- Recent / Quick Switch Vehicles -->
      <div class="quick-vehicles-box">
        <span class="sub-label">QUICK 3D PLATFORMS</span>
        <div class="quick-links-grid">
          <button class="btn-quick-vehicle" data-mfr="ferrari" data-model="ferrari-458-italia" type="button">
            🏎️ Ferrari 458
          </button>
          <button class="btn-quick-vehicle" data-mfr="aero-lab" data-model="sports-sedan-gt" type="button">
            🚗 Sports Sedan
          </button>
          <button class="btn-quick-vehicle" data-mfr="aero-lab" data-model="supercar-gt-midengine" type="button">
            ⚡ Supercar GT
          </button>
          <button class="btn-quick-vehicle" data-mfr="aero-lab" data-model="rugged-4x4-offroader" type="button">
            🚙 4x4 Off-Roader
          </button>
          <button class="btn-quick-vehicle" data-mfr="aero-lab" data-model="supersport-1000-bike" type="button">
            🏍️ 1000cc Bike
          </button>
        </div>
      </div>
    </aside>

    <!-- ================================================================= -->
    <!-- CENTER COLUMN: Interactive Three.js WebGL Automotive Studio -->
    <!-- ================================================================= -->
    <main class="studio-viewport-col">
      <!-- Viewport Header Toolbar -->
      <header class="viewport-header">
        <div class="viewport-title-box">
          <div class="viewport-badge-row">
            <span class="badge badge-cyan" id="vp-badge-status">3D Active</span>
            <span class="license-tag" id="vp-license-tag">Licensed Asset (CC-BY 4.0)</span>
          </div>
          <h2 class="viewport-vehicle-title" id="vp-vehicle-name">Ferrari 458 Italia Berlinetta</h2>
        </div>

        <!-- Camera Angles & Tools Toolbar -->
        <div class="viewport-actions">
          <div class="camera-presets-group">
            <button class="btn-cam" data-cam="three-quarter" type="button" title="3/4 Front Perspective">🎯 3/4</button>
            <button class="btn-cam" data-cam="front" type="button" title="Front View">🚘 Front</button>
            <button class="btn-cam" data-cam="side" type="button" title="Side Profile">🏎️ Side</button>
            <button class="btn-cam" data-cam="rear-three-quarter" type="button" title="3/4 Rear Perspective">🏁 Rear 3/4</button>
            <button class="btn-cam" data-cam="rear" type="button" title="Rear View">🔙 Rear</button>
            <button class="btn-cam" data-cam="top" type="button" title="Top Down View">🦅 Top</button>
          </div>

          <button id="btn-reset-camera" class="button button-small button-quiet" type="button" title="Center Camera">
            🎥 Center
          </button>
          <button id="btn-export-3d" class="button button-small button-primary" type="button" title="Capture High-Resolution Screenshot">
            📸 Screenshot
          </button>
        </div>
      </header>

      <!-- Viewport Container -->
      <div class="canvas-wrapper">
        <div id="canvas-container" class="canvas-container">
          <!-- WebGL Three.js Canvas Injected Here -->

          <!-- Loading Overlay -->
          <div id="loading-overlay" class="loading-overlay">
            <div class="spinner"></div>
            <span id="loading-text" class="loading-text">Loading 3D Vehicle Geometry...</span>
            <div class="progress-bar-track">
              <div id="loading-bar-fill" class="progress-bar-fill"></div>
            </div>
          </div>

          <!-- Fallback Unavailable Banner (When 3D CAD is pending legal clearance) -->
          <div id="unavailable-banner" class="unavailable-banner" style="display:none;">
            <div class="banner-card">
              <div class="banner-shield-icon">🛡️</div>
              <h3 id="unavail-title" class="unavail-title">3D Model Currently Unavailable for This Vehicle</h3>
              <p id="unavail-desc" class="unavail-desc">
                To strictly uphold automotive trademark standards and avoid unverified 3D representations, manufacturer-specific CAD geometry for this exact generation is undergoing legal license verification.
              </p>
              <div class="unavail-meta-box">
                <span class="unavail-meta-label">Licensing Audit Status:</span>
                <p id="unavail-attribution" class="unavail-meta-text">Awaiting manufacturer distribution license.</p>
              </div>
              <div class="banner-actions">
                <button id="btn-load-fallback" class="button button-primary" type="button">
                  🚀 Load Equivalent 3D Platform
                </button>
                <a href="/car-color-customizer/" class="button button-secondary">
                  🎨 Open 2D Customizer
                </a>
              </div>
            </div>
          </div>

          <!-- WebGL Hardware Support Fallback -->
          <div id="webgl-fallback" class="webgl-fallback" style="display:none;">
            <h3>WebGL Acceleration Required</h3>
            <p>Your browser or graphics environment does not support WebGL hardware rendering.</p>
            <a href="/car-color-customizer/" class="button button-primary">Use Lightweight 2D Customizer</a>
          </div>
        </div>

        <!-- Floating Viewport HUD -->
        <div class="viewport-hud">
          <div class="hud-pill" id="active-mesh-hud">
            <span class="hud-dot" id="hud-color-dot" style={`background:${initialColor};`}></span>
            <span id="hud-mesh-name">Selected: Aerodynamic Monocoque Body</span>
          </div>
          <div class="hud-hint">
            <span>💡 Left-click / drag to rotate &bull; Scroll / pinch to zoom &bull; Click any 3D panel to select</span>
          </div>
        </div>
      </div>

      <!-- Panel Selector Chips Strip -->
      <section class="panels-strip-container">
        <div class="strip-header">
          <span class="strip-title">Paintable Panels:</span>
          <span class="strip-count" id="panel-count-badge">3 Panels</span>
        </div>
        <div class="panel-chips-list" id="panel-chips-container">
          <!-- Dynamic panel chips injected via JavaScript -->
        </div>
      </section>
    </main>

    <!-- ================================================================= -->
    <!-- RIGHT SIDEBAR: Advanced Paint Controls, Materials & Wheels -->
    <!-- ================================================================= -->
    <aside class="studio-sidebar sidebar-right">
      <div class="sidebar-header">
        <h3 class="sidebar-title">Paint & Finish Studio</h3>
        <span class="badge badge-cyan" id="tag-active-finish">GLOSSY</span>
      </div>

      <!-- Active Panel Color Card -->
      <div class="card panel-color-card">
        <div class="card-header-row">
          <h4 id="panel-editor-title" class="editor-title">Panel Color: Body</h4>
          <span class="badge" id="tag-panel-node">Node: body</span>
        </div>

        <div class="color-picker-row">
          <input type="color" id="picker-3d" value={initialColor} class="native-picker" />
          <input type="text" id="hex-3d" value={initialColor} placeholder="#DC2626" class="hex-input" />
          <button id="btn-copy-hex" class="button button-small button-secondary" type="button">Copy</button>
          <button id="btn-star-color" class="button button-small button-quiet" type="button" title="Save to Favorites">⭐</button>
        </div>

        <!-- RGB & HSL Breakdown -->
        <div class="color-breakdown-row" id="color-breakdown">
          <span>RGB: <strong id="val-rgb">220, 38, 38</strong></span>
          <span>HSL: <strong id="val-hsl">0°, 72%, 51%</strong></span>
        </div>

        <!-- Palette Category Tabs -->
        <div class="palette-tabs">
          <button class="palette-tab is-active" data-palette="oem" type="button">OEM Factory</button>
          <button class="palette-tab" data-palette="pearl" type="button">Metallic / Pearl</button>
          <button class="palette-tab" data-palette="matte" type="button">Satin / Matte</button>
        </div>

        <!-- Swatches Grids -->
        <div class="swatches-container">
          <!-- OEM Swatches -->
          <div class="swatches-grid" id="grid-oem">
            {FACTORY_OEM_PALETTES.map((p) => (
              <button
                class="swatch-btn"
                data-hex={p.hex}
                data-finish={p.finish}
                title={`${p.name} (${p.hex})`}
                type="button"
                style={`background:${p.hex};`}
              />
            ))}
          </div>

          <!-- Metallic / Pearl Swatches -->
          <div class="swatches-grid" id="grid-pearl" style="display:none;">
            {METALLIC_PEARL_PALETTES.map((p) => (
              <button
                class="swatch-btn"
                data-hex={p.hex}
                data-finish={p.finish}
                title={`${p.name} (${p.hex})`}
                type="button"
                style={`background:${p.hex};`}
              />
            ))}
          </div>

          <!-- Satin / Matte Swatches -->
          <div class="swatches-grid" id="grid-matte" style="display:none;">
            {SATIN_MATTE_PALETTES.map((p) => (
              <button
                class="swatch-btn"
                data-hex={p.hex}
                data-finish={p.finish}
                title={`${p.name} (${p.hex})`}
                type="button"
                style={`background:${p.hex};`}
              />
            ))}
          </div>
        </div>

        <!-- Paint Scope Actions -->
        <div class="paint-actions-row">
          <button id="btn-apply-selected" class="button button-small button-primary" type="button">
            Apply to Selected Panel
          </button>
          <button id="btn-apply-all-panels" class="button button-small button-secondary" type="button" title="Apply color to all body panels">
            Apply to Entire Body
          </button>
        </div>
      </div>

      <!-- Material Finish Presets -->
      <div class="card material-card">
        <h4 class="card-section-title">Automotive Clearcoat & Finish</h4>
        <div class="finish-buttons-grid">
          <button class="btn-finish is-active" data-finish="glossy" type="button">Glossy Lacquer</button>
          <button class="btn-finish" data-finish="metallic" type="button">Metallic Flake</button>
          <button class="btn-finish" data-finish="matte" type="button">Matte Stealth</button>
          <button class="btn-finish" data-finish="satin" type="button">Satin Sheen</button>
          <button class="btn-finish" data-finish="pearl" type="button">Pearlescent</button>
          <button class="btn-finish" data-finish="chrome" type="button">Chrome Mirror</button>
        </div>

        <!-- Advanced Shader Sliders -->
        <div class="sliders-stack">
          <div class="slider-group">
            <div class="slider-header">
              <label for="slider-clearcoat" class="slider-label">Clearcoat Lacquer</label>
              <span id="val-clearcoat" class="slider-val">100%</span>
            </div>
            <input type="range" id="slider-clearcoat" min="0" max="100" value="100" class="custom-slider" />
          </div>

          <div class="slider-group">
            <div class="slider-header">
              <label for="slider-metalness" class="slider-label">Metalness / Flake</label>
              <span id="val-metalness" class="slider-val">65%</span>
            </div>
            <input type="range" id="slider-metalness" min="0" max="100" value="65" class="custom-slider" />
          </div>

          <div class="slider-group">
            <div class="slider-header">
              <label for="slider-roughness" class="slider-label">Surface Roughness</label>
              <span id="val-roughness" class="slider-val">16%</span>
            </div>
            <input type="range" id="slider-roughness" min="0" max="100" value="16" class="custom-slider" />
          </div>
        </div>
      </div>

      <!-- Wheels, Brake Calipers & Glass Accessories -->
      <div class="card accessories-card">
        <h4 class="card-section-title">Wheels & Accessories</h4>

        <!-- Wheel Rim Color Presets -->
        <div class="accessory-group">
          <label class="accessory-label">Wheel Rims</label>
          <div class="rim-swatches-grid">
            {RIM_FINISH_PRESETS.map((r) => (
              <button
                class="btn-rim-preset"
                data-rim={r.id}
                data-hex={r.hex}
                data-roughness={r.roughness}
                data-metalness={r.metalness}
                title={r.label}
                type="button"
                style={`background:${r.hex};`}
              />
            ))}
          </div>
        </div>

        <!-- Brake Calipers -->
        <div class="accessory-group">
          <label class="accessory-label">Brake Calipers</label>
          <div class="caliper-swatches-grid">
            {CALIPER_COLOR_PRESETS.map((c) => (
              <button
                class="btn-caliper-preset"
                data-caliper={c.id}
                data-hex={c.hex}
                title={c.label}
                type="button"
                style={`background:${c.hex};`}
              />
            ))}
          </div>
        </div>

        <!-- Glass Tint -->
        <div class="accessory-group">
          <label for="select-glass-tint" class="accessory-label">Window Tint</label>
          <select id="select-glass-tint" class="form-select">
            <option value="clear">Clear UV Protected (15%)</option>
            <option value="light">Light Tint (35%)</option>
            <option value="factory" selected>Factory Privacy Tint (50%)</option>
            <option value="limo">Limo Privacy Glass (85%)</option>
          </select>
        </div>
      </div>

      <!-- History, Comparison & Reset Actions -->
      <div class="history-actions-card">
        <div class="history-btn-row">
          <button id="btn-undo" class="button button-small button-secondary" type="button" title="Undo change (Ctrl+Z)">
            ↩ Undo
          </button>
          <button id="btn-redo" class="button button-small button-secondary" type="button" title="Redo change (Ctrl+Y)">
            ↪ Redo
          </button>
          <button id="btn-toggle-compare" class="button button-small button-quiet" type="button" title="Toggle Factory Color Comparison">
            ⚖️ Before / After
          </button>
        </div>

        <div class="reset-btn-row">
          <button id="btn-reset-panel" class="button button-small button-quiet" type="button">
            Reset Panel
          </button>
          <button id="btn-reset-vehicle" class="button button-small button-quiet" type="button">
            Reset All
          </button>
        </div>
      </div>
    </aside>
  </div>
</div>

<style>
  .studio-root {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }

  /* Category Filter Bar */
  .category-filters-bar {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 8px 12px;
    overflow: hidden;
  }
  .category-scroll {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .category-scroll::-webkit-scrollbar {
    display: none;
  }
  .cat-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    background: var(--surface-elevated);
    color: var(--muted);
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .cat-pill:hover {
    color: var(--ink);
    border-color: var(--border);
  }
  .cat-pill.is-active {
    background: rgba(139, 124, 255, 0.15);
    color: var(--brand-indigo);
    border-color: var(--brand-indigo);
  }

  /* 3-Column Studio Grid */
  .studio-grid {
    display: grid;
    grid-template-columns: 290px 1fr 330px;
    gap: 16px;
    min-height: 720px;
  }

  /* Responsive Stacking */
  @media (max-width: 1200px) {
    .studio-grid {
      grid-template-columns: 270px 1fr 310px;
    }
  }
  @media (max-width: 1024px) {
    .studio-grid {
      grid-template-columns: 1fr;
    }
