<script>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
  import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
  import { DRACOLoader } from 'three/examples/jsm/loaders/DRACOLoader.js';
  import type { MarketCountry, VehicleAsset3D, MeshPanelMapping } from '../types/vehicleCatalogue';

  // Initialize Customizer Engine on DOM Ready
  document.addEventListener('DOMContentLoaded', initStudio);

  function initStudio() {
    const root = document.getElementById('studio-root');
    if (!root) return;
    const initialDefaultColor = root.dataset.initialColor || '#DC2626';

    // Parse Data Scripts
    const catalogueEl = document.getElementById('catalogue-data');
    const assetEl = document.getElementById('asset-registry-data');
    if (!catalogueEl || !assetEl) return;

    const catalogue: MarketCountry[] = JSON.parse(catalogueEl.textContent || '[]');
    const assetRegistry: Record<string, VehicleAsset3D> = JSON.parse(assetEl.textContent || '{}');

    // DOM References - Hierarchy Selectors
    const selectCountry = document.getElementById('select-country') as HTMLSelectElement;
    const inputSearchMfr = document.getElementById('input-search-mfr') as HTMLInputElement;
    const selectMfr = document.getElementById('select-mfr') as HTMLSelectElement;
    const inputSearchModel = document.getElementById('input-search-model') as HTMLInputElement;
    const selectModel = document.getElementById('select-model') as HTMLSelectElement;
    const selectGeneration = document.getElementById('select-generation') as HTMLSelectElement;
    const selectYear = document.getElementById('select-year') as HTMLSelectElement;
    const selectVariant = document.getElementById('select-variant') as HTMLSelectElement;

    const badgeCountryName = document.getElementById('badge-country-name');
    const statusDot = document.getElementById('status-dot');
    const statusTitle = document.getElementById('status-title');
    const statusDesc = document.getElementById('status-desc');
    const badgeDrivetrain = document.getElementById('badge-drivetrain');
    const badgeTransmission = document.getElementById('badge-transmission');

    const specEngine = document.getElementById('spec-engine');
    const specPower = document.getElementById('spec-power');
    const specTorque = document.getElementById('spec-torque');
    const specTrans = document.getElementById('spec-trans');
    const specDrive = document.getElementById('spec-drive');

    // DOM References - Viewport & HUD
    const canvasContainer = document.getElementById('canvas-container');
    const vpBadgeStatus = document.getElementById('vp-badge-status');
    const vpLicenseTag = document.getElementById('vp-license-tag');
    const vpVehicleName = document.getElementById('vp-vehicle-name');
    const loadingOverlay = document.getElementById('loading-overlay');
    const loadingText = document.getElementById('loading-text');
    const loadingBarFill = document.getElementById('loading-bar-fill');
    const unavailableBanner = document.getElementById('unavailable-banner');
    const unavailTitle = document.getElementById('unavail-title');
    const unavailDesc = document.getElementById('unavail-desc');
    const unavailAttribution = document.getElementById('unavail-attribution');
    const btnLoadFallback = document.getElementById('btn-load-fallback');
    const webglFallback = document.getElementById('webgl-fallback');

    const hudMeshName = document.getElementById('hud-mesh-name');
    const hudColorDot = document.getElementById('hud-color-dot');
    const panelChipsContainer = document.getElementById('panel-chips-container');
    const panelCountBadge = document.getElementById('panel-count-badge');

    // DOM References - Color & Material Controls
    const panelEditorTitle = document.getElementById('panel-editor-title');
    const tagPanelNode = document.getElementById('tag-panel-node');
    const tagActiveFinish = document.getElementById('tag-active-finish');
    const picker3D = document.getElementById('picker-3d') as HTMLInputElement;
    const hex3D = document.getElementById('hex-3d') as HTMLInputElement;
    const btnCopyHex = document.getElementById('btn-copy-hex');
    const btnStarColor = document.getElementById('btn-star-color');
    const valRgb = document.getElementById('val-rgb');
    const valHsl = document.getElementById('val-hsl');

    const btnApplySelected = document.getElementById('btn-apply-selected');
    const btnApplyAllPanels = document.getElementById('btn-apply-all-panels');
    const finishBtns = document.querySelectorAll('.btn-finish');

    const sliderClearcoat = document.getElementById('slider-clearcoat') as HTMLInputElement;
    const sliderMetalness = document.getElementById('slider-metalness') as HTMLInputElement;
    const sliderRoughness = document.getElementById('slider-roughness') as HTMLInputElement;
    const valClearcoat = document.getElementById('val-clearcoat');
    const valMetalness = document.getElementById('val-metalness');
    const valRoughness = document.getElementById('val-roughness');

    const rimPresets = document.querySelectorAll('.btn-rim-preset');
    const caliperPresets = document.querySelectorAll('.btn-caliper-preset');
    const selectGlassTint = document.getElementById('select-glass-tint') as HTMLSelectElement;

    const btnUndo = document.getElementById('btn-undo');
    const btnRedo = document.getElementById('btn-redo');
    const btnToggleCompare = document.getElementById('btn-toggle-compare');
    const btnResetPanel = document.getElementById('btn-reset-panel');
    const btnResetVehicle = document.getElementById('btn-reset-vehicle');
    const btnResetCam = document.getElementById('btn-reset-camera');
    const btnExport = document.getElementById('btn-export-3d');

    // Check WebGL availability
    function isWebGLAvailable() {
      try {
        const c = document.createElement('canvas');
        return !!(window.WebGLRenderingContext && (c.getContext('webgl') || c.getContext('experimental-webgl')));
      } catch (e) {
        return false;
      }
    }

    if (!isWebGLAvailable() || !canvasContainer) {
      if (webglFallback) webglFallback.style.display = 'block';
      return;
    }

    // Three.js Scene Setup
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x0b1020);

    const camera = new THREE.PerspectiveCamera(38, canvasContainer.clientWidth / canvasContainer.clientHeight, 0.1, 100);
    camera.position.set(3.4, 1.4, 3.4);

    const renderer = new THREE.WebGLRenderer({
      antialias: true,
      preserveDrawingBuffer: true,
      alpha: true,
      powerPreference: 'high-performance'
    });
    renderer.setSize(canvasContainer.clientWidth, canvasContainer.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;
    canvasContainer.appendChild(renderer.domElement);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.maxPolarAngle = Math.PI / 2 + 0.02;
    controls.minDistance = 1.8;
    controls.maxDistance = 10.0;

    // Studio Lighting
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.65);
    scene.add(ambientLight);

    const hemiLight = new THREE.HemisphereLight(0xe0f2fe, 0x0f172a, 0.65);
    hemiLight.position.set(0, 15, 0);
    scene.add(hemiLight);

    // 1. Overhead Studio Softbox
    const overheadLight = new THREE.DirectionalLight(0xffffff, 1.25);
    overheadLight.position.set(0, 10, 0);
    scene.add(overheadLight);

    // 2. 3/4 Key Light with soft shadows
    const keyLight = new THREE.DirectionalLight(0xffffff, 1.7);
    keyLight.position.set(6, 7, 7);
    keyLight.castShadow = true;
    keyLight.shadow.mapSize.width = 2048;
    keyLight.shadow.mapSize.height = 2048;
    keyLight.shadow.camera.near = 0.5;
    keyLight.shadow.camera.far = 25;
    keyLight.shadow.bias = -0.0004;
    keyLight.shadow.radius = 2.5;
    scene.add(keyLight);

    // 3. Horizon Shoulder Accent Light (creates high metallic reflections)
    const rimLight = new THREE.DirectionalLight(0x38bdf8, 1.2);
    rimLight.position.set(-8, 3.5, 2);
    scene.add(rimLight);

    // 4. Rear Separation Light
    const rearLight = new THREE.DirectionalLight(0xa78bfa, 0.8);
    rearLight.position.set(-4, 5, -8);
    scene.add(rearLight);

    // Ground Shadow & Grid Plane
    const groundGeom = new THREE.PlaneGeometry(32, 32);
    const groundMat = new THREE.MeshStandardMaterial({
      color: 0x080d1a,
      roughness: 0.85,
      metalness: 0.15
    });
    const ground = new THREE.Mesh(groundGeom, groundMat);
    ground.rotation.x = -Math.PI / 2;
    ground.position.y = -0.01;
    ground.receiveShadow = true;
    scene.add(ground);

    const gridHelper = new THREE.GridHelper(20, 20, 0x22d3ee, 0x1e293b);
    gridHelper.position.y = 0;
    scene.add(gridHelper);

    // Configure DRACO and GLTF Loaders
    const dracoLoader = new DRACOLoader();
    dracoLoader.setDecoderPath('/draco/gltf/');

    const gltfLoader = new GLTFLoader();
    gltfLoader.setDRACOLoader(dracoLoader);

    // Application State
    let currentCountryCode = root.dataset.initialMarket || 'IT';
    let currentMfrId = root.dataset.initialManufacturer || 'ferrari';
    let currentModelId = root.dataset.initialModel || 'ferrari-458-italia';
    let currentGenId = '';
    let currentYear = 2015;
    let currentVariantId = '';
    let currentCategoryFilter = 'all';

    let activeAsset: VehicleAsset3D | null = null;
    let loadedVehicleObject: THREE.Object3D | null = null;
    let activePanelMapping: MeshPanelMapping | null = null;
    let activeMeshObject: THREE.Mesh | null = null;

    // Per-Vehicle Customization Storage
    interface PanelColorState {
      hex: string;
      finish: 'glossy' | 'metallic' | 'matte' | 'satin' | 'pearl' | 'chrome';
      roughness: number;
      metalness: number;
      clearcoat: number;
      clearcoatRoughness: number;
    }
    const vehicleConfigs: Record<string, Record<string, PanelColorState>> = {};
    const undoStack: string[] = [];
    const redoStack: string[] = [];
    let isComparingFactory = false;
    let preCompareSnapshot: Record<string, PanelColorState> | null = null;

    // Raycaster for 3D Panel Clicking & Hover
    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2();

    renderer.domElement.addEventListener('pointerdown', (e) => {
      const rect = renderer.domElement.getBoundingClientRect();
      mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

      raycaster.setFromCamera(mouse, camera);
      if (!loadedVehicleObject || !activeAsset) return;

      const intersects = raycaster.intersectObjects(loadedVehicleObject.children, true);
      for (const hit of intersects) {
        const obj = hit.object;
        if (obj instanceof THREE.Mesh) {
          // Check if mesh corresponds to any paintable panel
          const panel = activeAsset.meshMappings.paintablePanels.find(
            (p) => p.nodeName === obj.name || (p.nodeName === 'body' && obj.name.toLowerCase().includes('body'))
          );
          if (panel) {
            selectPanel(panel);
            break;
          }
        }
      }
    });

    // Hover cursor feedback
    renderer.domElement.addEventListener('pointermove', (e) => {
      const rect = renderer.domElement.getBoundingClientRect();
      mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

      raycaster.setFromCamera(mouse, camera);
      if (!loadedVehicleObject || !activeAsset) {
        renderer.domElement.style.cursor = 'grab';
        return;
      }

      const intersects = raycaster.intersectObjects(loadedVehicleObject.children, true);
      let hitPaintable = false;
      for (const hit of intersects) {
        const obj = hit.object;
        if (obj instanceof THREE.Mesh) {
          const panel = activeAsset.meshMappings.paintablePanels.find((p) => p.nodeName === obj.name);
          if (panel) {
            hitPaintable = true;
            break;
          }
        }
      }
      renderer.domElement.style.cursor = hitPaintable ? 'pointer' : 'grab';
    });

    // Helper: Hex to RGB & HSL
    function hexToRgbHsl(hex: string) {
      let c = hex.replace('#', '');
      if (c.length === 3) c = c.split('').map((x) => x + x).join('');
      const num = parseInt(c, 16);
      const r = (num >> 16) & 255;
      const g = (num >> 8) & 255;
      const b = num & 255;

      const rNorm = r / 255;
      const gNorm = g / 255;
      const bNorm = b / 255;
      const max = Math.max(rNorm, gNorm, bNorm);
      const min = Math.min(rNorm, gNorm, bNorm);
      let h = 0;
      let s = 0;
      const l = (max + min) / 2;

      if (max !== min) {
        const d = max - min;
        s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
        switch (max) {
          case rNorm: h = (gNorm - bNorm) / d + (gNorm < bNorm ? 6 : 0); break;
          case gNorm: h = (bNorm - rNorm) / d + 2; break;
          case bNorm: h = (rNorm - gNorm) / d + 4; break;
        }
        h /= 6;
      }

      return {
        rgb: `${r}, ${g}, ${b}`,
        hsl: `${Math.round(h * 360)}°, ${Math.round(s * 100)}%, ${Math.round(l * 100)}%`
      };
    }

    // Material finish configurations with MeshPhysicalMaterial clearcoat
    function applyFinishToMaterial(
      mat: THREE.MeshPhysicalMaterial,
      finish: 'glossy' | 'metallic' | 'matte' | 'satin' | 'pearl' | 'chrome',
      customRoughness?: number,
      customMetalness?: number,
      customClearcoat?: number
    ) {
      if (finish === 'glossy') {
        mat.roughness = customRoughness !== undefined ? customRoughness : 0.16;
        mat.metalness = customMetalness !== undefined ? customMetalness : 0.65;
        mat.clearcoat = customClearcoat !== undefined ? customClearcoat : 1.0;
        mat.clearcoatRoughness = 0.04;
      } else if (finish === 'metallic') {
        mat.roughness = customRoughness !== undefined ? customRoughness : 0.20;
        mat.metalness = customMetalness !== undefined ? customMetalness : 0.92;
        mat.clearcoat = customClearcoat !== undefined ? customClearcoat : 1.0;
        mat.clearcoatRoughness = 0.08;
      } else if (finish === 'satin') {
        mat.roughness = customRoughness !== undefined ? customRoughness : 0.42;
        mat.metalness = customMetalness !== undefined ? customMetalness : 0.35;
        mat.clearcoat = customClearcoat !== undefined ? customClearcoat : 0.35;
        mat.clearcoatRoughness = 0.40;
      } else if (finish === 'matte') {
        mat.roughness = customRoughness !== undefined ? customRoughness : 0.85;
        mat.metalness = customMetalness !== undefined ? customMetalness : 0.08;
        mat.clearcoat = 0.0;
        mat.clearcoatRoughness = 1.0;
      } else if (finish === 'pearl') {
        mat.roughness = customRoughness !== undefined ? customRoughness : 0.18;
        mat.metalness = customMetalness !== undefined ? customMetalness : 0.55;
        mat.clearcoat = customClearcoat !== undefined ? customClearcoat : 1.0;
        mat.clearcoatRoughness = 0.12;
      } else if (finish === 'chrome') {
        mat.roughness = 0.05;
        mat.metalness = 1.0;
        mat.clearcoat = 1.0;
        mat.clearcoatRoughness = 0.02;
      }
      mat.needsUpdate = true;
    }

    // Configuration retrieval / initialization
    function getVehicleConfig(): Record<string, PanelColorState> {
      if (!activeAsset) return {};
      const assetId = activeAsset.assetId;
      if (!vehicleConfigs[assetId]) {
        const saved = localStorage.getItem(`colorcode_studio_${assetId}`);
        if (saved) {
          try {
            vehicleConfigs[assetId] = JSON.parse(saved);
          } catch (e) {}
        }
        if (!vehicleConfigs[assetId]) {
          const cfg: Record<string, PanelColorState> = {};
          activeAsset.meshMappings.paintablePanels.forEach((p) => {
            cfg[p.id] = {
              hex: p.defaultColor || initialDefaultColor,
              finish: p.defaultFinish || 'glossy',
              roughness: 0.18,
              metalness: 0.65,
              clearcoat: 1.0,
              clearcoatRoughness: 0.04
            };
          });
          vehicleConfigs[assetId] = cfg;
        }
      }
      return vehicleConfigs[assetId];
    }

    function recordHistory() {
      const snap = JSON.stringify(getVehicleConfig());
      undoStack.push(snap);
      if (undoStack.length > 30) undoStack.shift();
      redoStack.length = 0; // Clear redo on new action
    }

    // Load 3D Asset into Three.js Scene
    function loadAssetModel(asset: VehicleAsset3D) {
      activeAsset = asset;

      if (unavailableBanner) unavailableBanner.style.display = 'none';
      if (loadingOverlay) {
        loadingOverlay.style.display = 'flex';
        if (loadingText) loadingText.textContent = `Loading 3D Geometry: ${asset.vehicleRef.model}...`;
        if (loadingBarFill) loadingBarFill.style.width = '15%';
      }

      // Dispose previously loaded 3D resources to prevent memory leaks
      if (loadedVehicleObject) {
        loadedVehicleObject.traverse((c) => {
          if (c instanceof THREE.Mesh) {
            c.geometry?.dispose();
            if (Array.isArray(c.material)) {
              c.material.forEach((m) => m.dispose());
            } else if (c.material) {
              c.material.dispose();
            }
          }
        });
        scene.remove(loadedVehicleObject);
        loadedVehicleObject = null;
      }

      gltfLoader.load(
        asset.glbUrl,
        (gltf) => {
          if (loadingOverlay) loadingOverlay.style.display = 'none';
          const obj = gltf.scene;
          loadedVehicleObject = obj;
          scene.add(obj);

          // Update Viewport Title and Tags
          if (vpVehicleName) vpVehicleName.textContent = `${asset.vehicleRef.manufacturer} ${asset.vehicleRef.model}`;
          if (vpBadgeStatus) {
            vpBadgeStatus.textContent = '3D Active';
            vpBadgeStatus.className = 'badge badge-cyan';
          }
          if (vpLicenseTag) {
            vpLicenseTag.textContent = `License: ${asset.license.licenseType} (${asset.license.author})`;
          }

          // Camera setup
          camera.position.set(...asset.cameraDefaults.position);
          controls.target.set(...asset.cameraDefaults.target);
          camera.fov = asset.cameraDefaults.fov;
          camera.updateProjectionMatrix();
          controls.update();

          // Apply saved panel materials and setup PBR MeshPhysicalMaterials
          const cfg = getVehicleConfig();

          obj.traverse((child) => {
            if (child instanceof THREE.Mesh) {
              child.castShadow = true;
              child.receiveShadow = true;

              // 1. Paintable Panels
              const panelDef = asset.meshMappings.paintablePanels.find(
                (p) => p.nodeName === child.name || (p.nodeName === 'body' && child.name.toLowerCase().includes('body'))
              );
              if (panelDef) {
                const origCol = (child.material as THREE.MeshStandardMaterial).color || new THREE.Color(0xdc2626);
                const physMat = new THREE.MeshPhysicalMaterial({
                  color: origCol.clone(),
                  metalness: 0.65,
                  roughness: 0.18,
                  clearcoat: 1.0,
                  clearcoatRoughness: 0.04
                });
                child.material = physMat;

                const pCfg = cfg[panelDef.id];
                if (pCfg) {
                  physMat.color.set(pCfg.hex);
                  applyFinishToMaterial(physMat, pCfg.finish, pCfg.roughness, pCfg.metalness, pCfg.clearcoat);
                }
              }

              // 2. Wheel Rims
              if (asset.meshMappings.wheelRims.includes(child.name) || child.name.toLowerCase().includes('rim')) {
                const rimMat = new THREE.MeshStandardMaterial({
                  color: 0xe2e8f0,
                  metalness: 0.9,
                  roughness: 0.2
                });
                child.material = rimMat;
              }

              // 3. Tires (ensure pure rubber texture and protect from recoloring)
              if (asset.meshMappings.wheelTires.includes(child.name) || child.name.toLowerCase().includes('tire')) {
                const tireMat = new THREE.MeshStandardMaterial({
                  color: 0x18181b,
                  metalness: 0.05,
                  roughness: 0.85
                });
                child.material = tireMat;
              }

              // 4. Glass
              if (asset.meshMappings.glassMeshes.includes(child.name) || child.name.toLowerCase().includes('glass')) {
                const glassMat = new THREE.MeshPhysicalMaterial({
                  color: 0xffffff,
                  transparent: true,
                  opacity: 0.5,
                  roughness: 0.05,
                  metalness: 0.1,
                  transmission: 0.9,
                  ior: 1.5
                });
                child.material = glassMat;
              }
            }
          });

          // Render Panel Selection Strip
          renderPanelChips();

          // Select first panel by default
          if (asset.meshMappings.paintablePanels.length > 0) {
            selectPanel(asset.meshMappings.paintablePanels[0]);
          }
        },
        (progress) => {
          if (progress.total > 0 && loadingBarFill) {
            const pct = Math.round((progress.loaded / progress.total) * 100);
            loadingBarFill.style.width = `${pct}%`;
            if (loadingText) loadingText.textContent = `Downloading 3D Mesh: ${pct}%`;
          }
        },
        (err) => {
          if (loadingOverlay) loadingOverlay.style.display = 'none';
          console.error('Failed to load 3D Asset:', err);
        }
      );
    }

    // Render Dynamic Panel Chips
    function renderPanelChips() {
      if (!panelChipsContainer || !activeAsset) return;
      panelChipsContainer.innerHTML = '';
      if (panelCountBadge) {
        panelCountBadge.textContent = `${activeAsset.meshMappings.paintablePanels.length} Panels`;
      }

      const cfg = getVehicleConfig();

      activeAsset.meshMappings.paintablePanels.forEach((panel) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `panel-chip ${activePanelMapping?.id === panel.id ? 'is-active' : ''}`;
        btn.dataset.panelId = panel.id;

        const pCfg = cfg[panel.id];
        const hex = pCfg?.hex || panel.defaultColor || '#DC2626';

        btn.innerHTML = `
          <span class="panel-chip-dot" style="background:${hex};"></span>
          <span>${panel.name}</span>
        `;

        btn.addEventListener('click', () => {
          selectPanel(panel);
        });

        panelChipsContainer.appendChild(btn);
      });
    }

    // Select Active Panel
    function selectPanel(panel: MeshPanelMapping) {
      activePanelMapping = panel;

      // Locate corresponding 3D Mesh in Scene
      if (loadedVehicleObject) {
        activeMeshObject = null;
        loadedVehicleObject.traverse((child) => {
          if (child instanceof THREE.Mesh && (child.name === panel.nodeName || (panel.nodeName === 'body' && child.name.toLowerCase().includes('body')))) {
            activeMeshObject = child;
          }
        });
      }

      // Update HUD and Editor Controls
      const cfg = getVehicleConfig();
      const pCfg = cfg[panel.id] || {
        hex: panel.defaultColor || '#DC2626',
        finish: 'glossy',
        roughness: 0.18,
        metalness: 0.65,
        clearcoat: 1.0,
        clearcoatRoughness: 0.04
      };

      if (hudMeshName) hudMeshName.textContent = `Selected: ${panel.name}`;
      if (hudColorDot) hudColorDot.style.background = pCfg.hex;
      if (panelEditorTitle) panelEditorTitle.textContent = `Panel: ${panel.name}`;
      if (tagPanelNode) tagPanelNode.textContent = `Node: ${panel.nodeName}`;

      if (picker3D) picker3D.value = pCfg.hex;
      if (hex3D) hex3D.value = pCfg.hex.toUpperCase();

      const { rgb, hsl } = hexToRgbHsl(pCfg.hex);
      if (valRgb) valRgb.textContent = rgb;
      if (valHsl) valHsl.textContent = hsl;

      if (tagActiveFinish) tagActiveFinish.textContent = pCfg.finish.toUpperCase();

      finishBtns.forEach((btn) => {
        const f = (btn as HTMLElement).dataset.finish;
        btn.classList.toggle('is-active', f === pCfg.finish);
      });

      if (sliderRoughness) sliderRoughness.value = String(Math.round(pCfg.roughness * 100));
      if (sliderMetalness) sliderMetalness.value = String(Math.round(pCfg.metalness * 100));
      if (sliderClearcoat) sliderClearcoat.value = String(Math.round(pCfg.clearcoat * 100));

      if (valRoughness) valRoughness.textContent = `${Math.round(pCfg.roughness * 100)}%`;
      if (valMetalness) valMetalness.textContent = `${Math.round(pCfg.metalness * 100)}%`;
      if (valClearcoat) valClearcoat.textContent = `${Math.round(pCfg.clearcoat * 100)}%`;

      // Update chip active status
      const chips = panelChipsContainer?.querySelectorAll('.panel-chip');
      chips?.forEach((c) => {
        const chipEl = c as HTMLElement;
        chipEl.classList.toggle('is-active', chipEl.dataset.panelId === panel.id);
      });
    }

    // Apply Color to Active Panel
    function applyColorToActivePanel(hex: string) {
      if (!activePanelMapping || !activeMeshObject || !activeAsset) return;
      recordHistory();

      const cfg = getVehicleConfig();
      if (!cfg[activePanelMapping.id]) {
        cfg[activePanelMapping.id] = {
          hex,
          finish: 'glossy',
          roughness: 0.18,
          metalness: 0.65,
          clearcoat: 1.0,
          clearcoatRoughness: 0.04
        };
      } else {
        cfg[activePanelMapping.id].hex = hex;
      }

      const mat = activeMeshObject.material as THREE.MeshPhysicalMaterial;
      mat.color.set(hex);
      mat.needsUpdate = true;

      if (hudColorDot) hudColorDot.style.background = hex;
      if (picker3D) picker3D.value = hex;
      if (hex3D) hex3D.value = hex.toUpperCase();

      const { rgb, hsl } = hexToRgbHsl(hex);
      if (valRgb) valRgb.textContent = rgb;
      if (valHsl) valHsl.textContent = hsl;

      // Update Chip Dot
      const chip = panelChipsContainer?.querySelector(`.panel-chip[data-panel-id="${activePanelMapping.id}"] .panel-chip-dot`) as HTMLElement;
      if (chip) chip.style.background = hex;

      localStorage.setItem(`colorcode_studio_${activeAsset.assetId}`, JSON.stringify(cfg));
    }

    // Apply Color to All Paintable Panels
    function applyColorToAllPanels(hex: string) {
      if (!activeAsset || !loadedVehicleObject) return;
      recordHistory();

      const cfg = getVehicleConfig();
      activeAsset.meshMappings.paintablePanels.forEach((p) => {
        if (!cfg[p.id]) {
          cfg[p.id] = {
            hex,
            finish: 'glossy',
            roughness: 0.18,
            metalness: 0.65,
            clearcoat: 1.0,
            clearcoatRoughness: 0.04
          };
        } else {
          cfg[p.id].hex = hex;
        }
      });

      loadedVehicleObject.traverse((child) => {
        if (child instanceof THREE.Mesh) {
          const panel = activeAsset!.meshMappings.paintablePanels.find(
            (p) => p.nodeName === child.name || (p.nodeName === 'body' && child.name.toLowerCase().includes('body'))
          );
          if (panel) {
            const m = child.material as THREE.MeshPhysicalMaterial;
            m.color.set(hex);
            m.needsUpdate = true;
          }
        }
      });

      if (activePanelMapping) selectPanel(activePanelMapping);
      renderPanelChips();
      localStorage.setItem(`colorcode_studio_${activeAsset.assetId}`, JSON.stringify(cfg));
    }

    // Apply Finish to Active Panel
    function applyFinishToActivePanel(finish: 'glossy' | 'metallic' | 'matte' | 'satin' | 'pearl' | 'chrome') {
      if (!activePanelMapping || !activeMeshObject || !activeAsset) return;
      recordHistory();

      const cfg = getVehicleConfig();
      const pCfg = cfg[activePanelMapping.id];
      if (pCfg) {
        pCfg.finish = finish;
      }

      const mat = activeMeshObject.material as THREE.MeshPhysicalMaterial;
      applyFinishToMaterial(mat, finish);

      if (pCfg) {
        pCfg.roughness = mat.roughness;
        pCfg.metalness = mat.metalness;
        pCfg.clearcoat = mat.clearcoat;
      }

      if (tagActiveFinish) tagActiveFinish.textContent = finish.toUpperCase();

      finishBtns.forEach((btn) => {
        const f = (btn as HTMLElement).dataset.finish;
        btn.classList.toggle('is-active', f === finish);
      });

      if (sliderRoughness) sliderRoughness.value = String(Math.round(mat.roughness * 100));
      if (sliderMetalness) sliderMetalness.value = String(Math.round(mat.metalness * 100));
      if (sliderClearcoat) sliderClearcoat.value = String(Math.round(mat.clearcoat * 100));

      if (valRoughness) valRoughness.textContent = `${Math.round(mat.roughness * 100)}%`;
      if (valMetalness) valMetalness.textContent = `${Math.round(mat.metalness * 100)}%`;
      if (valClearcoat) valClearcoat.textContent = `${Math.round(mat.clearcoat * 100)}%`;

      localStorage.setItem(`colorcode_studio_${activeAsset.assetId}`, JSON.stringify(cfg));
    }

    // Pickers and Inputs Event Handlers
    picker3D?.addEventListener('input', (e) => {
      const hex = (e.target as HTMLInputElement).value;
      applyColorToActivePanel(hex);
    });

    hex3D?.addEventListener('change', (e) => {
      let val = (e.target as HTMLInputElement).value.trim();
      if (!val.startsWith('#')) val = '#' + val;
      if (/^#[0-9A-Fa-f]{6}$/.test(val)) {
        applyColorToActivePanel(val);
      }
    });

    btnCopyHex?.addEventListener('click', () => {
      if (hex3D?.value) {
        navigator.clipboard.writeText(hex3D.value).then(() => {
          btnCopyHex.textContent = 'Copied!';
          setTimeout(() => (btnCopyHex.textContent = 'Copy'), 1500);
        });
      }
    });

    btnStarColor?.addEventListener('click', () => {
      if (hex3D?.value) {
        const favs: string[] = JSON.parse(localStorage.getItem('colorcode_favorites') || '[]');
        if (!favs.includes(hex3D.value)) {
          favs.unshift(hex3D.value);
          localStorage.setItem('colorcode_favorites', JSON.stringify(favs.slice(0, 20)));
        }
        btnStarColor.textContent = '🌟';
        setTimeout(() => (btnStarColor.textContent = '⭐'), 1200);
      }
    });

    btnApplySelected?.addEventListener('click', () => {
      if (hex3D?.value) applyColorToActivePanel(hex3D.value);
    });

    btnApplyAllPanels?.addEventListener('click', () => {
      if (hex3D?.value) applyColorToAllPanels(hex3D.value);
    });

    // Swatches Click
    document.querySelectorAll('.swatch-btn').forEach((swatch) => {
      swatch.addEventListener('click', () => {
        const el = swatch as HTMLElement;
        const hex = el.dataset.hex;
        const finish = el.dataset.finish as any;
        if (hex) {
          applyColorToActivePanel(hex);
          if (finish) applyFinishToActivePanel(finish);
        }
      });
    });

    // Finish Buttons Click
    finishBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const f = (btn as HTMLElement).dataset.finish as any;
        if (f) applyFinishToActivePanel(f);
      });
    });

    // Sliders
    sliderClearcoat?.addEventListener('input', (e) => {
      const val = Number((e.target as HTMLInputElement).value) / 100;
      if (valClearcoat) valClearcoat.textContent = `${Math.round(val * 100)}%`;
      if (activePanelMapping && activeMeshObject) {
        const mat = activeMeshObject.material as THREE.MeshPhysicalMaterial;
        mat.clearcoat = val;
        mat.needsUpdate = true;
        const cfg = getVehicleConfig();
        if (cfg[activePanelMapping.id]) cfg[activePanelMapping.id].clearcoat = val;
      }
    });

    sliderMetalness?.addEventListener('input', (e) => {
      const val = Number((e.target as HTMLInputElement).value) / 100;
      if (valMetalness) valMetalness.textContent = `${Math.round(val * 100)}%`;
      if (activePanelMapping && activeMeshObject) {
        const mat = activeMeshObject.material as THREE.MeshPhysicalMaterial;
        mat.metalness = val;
        mat.needsUpdate = true;
        const cfg = getVehicleConfig();
        if (cfg[activePanelMapping.id]) cfg[activePanelMapping.id].metalness = val;
      }
    });

    sliderRoughness?.addEventListener('input', (e) => {
      const val = Number((e.target as HTMLInputElement).value) / 100;
      if (valRoughness) valRoughness.textContent = `${Math.round(val * 100)}%`;
      if (activePanelMapping && activeMeshObject) {
        const mat = activeMeshObject.material as THREE.MeshPhysicalMaterial;
        mat.roughness = val;
        mat.needsUpdate = true;
        const cfg = getVehicleConfig();
        if (cfg[activePanelMapping.id]) cfg[activePanelMapping.id].roughness = val;
      }
    });

    // Wheel Rim Presets Click
    rimPresets.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!loadedVehicleObject || !activeAsset) return;
        const el = btn as HTMLElement;
        const hex = el.dataset.hex || '#E2E8F0';
        const roughness = Number(el.dataset.roughness || 0.2);
        const metalness = Number(el.dataset.metalness || 0.9);

        loadedVehicleObject.traverse((child) => {
          if (child instanceof THREE.Mesh && (activeAsset!.meshMappings.wheelRims.includes(child.name) || child.name.toLowerCase().includes('rim'))) {
            const m = child.material as THREE.MeshStandardMaterial;
            m.color.set(hex);
            m.roughness = roughness;
            m.metalness = metalness;
            m.needsUpdate = true;
          }
        });
      });
    });

    // Caliper Presets Click
    caliperPresets.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!loadedVehicleObject || !activeAsset) return;
        const hex = (btn as HTMLElement).dataset.hex || '#DC2626';

        loadedVehicleObject.traverse((child) => {
          if (child instanceof THREE.Mesh && (activeAsset!.meshMappings.brakeCalipers.includes(child.name) || child.name.toLowerCase().includes('brake'))) {
            const m = child.material as THREE.MeshStandardMaterial;
            m.color.set(hex);
            m.metalness = 0.5;
            m.roughness = 0.3;
            m.needsUpdate = true;
          }
        });
      });
    });

    // Window Tint Select
    selectGlassTint?.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      if (!loadedVehicleObject || !activeAsset) return;
      const opacity = val === 'clear' ? 0.25 : val === 'light' ? 0.45 : val === 'factory' ? 0.65 : 0.88;

      loadedVehicleObject.traverse((child) => {
        if (child instanceof THREE.Mesh && (activeAsset!.meshMappings.glassMeshes.includes(child.name) || child.name.toLowerCase().includes('glass'))) {
          const m = child.material as THREE.MeshPhysicalMaterial;
          m.opacity = opacity;
          m.needsUpdate = true;
        }
      });
    });

    // Palette Tabs Switcher
    const paletteTabs = document.querySelectorAll('.palette-tab');
    paletteTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        paletteTabs.forEach((t) => t.classList.remove('is-active'));
        tab.classList.add('is-active');
        const p = (tab as HTMLElement).dataset.palette;
        const gridOem = document.getElementById('grid-oem');
        const gridPearl = document.getElementById('grid-pearl');
        const gridMatte = document.getElementById('grid-matte');
        if (gridOem) gridOem.style.display = p === 'oem' ? 'grid' : 'none';
        if (gridPearl) gridPearl.style.display = p === 'pearl' ? 'grid' : 'none';
        if (gridMatte) gridMatte.style.display = p === 'matte' ? 'grid' : 'none';
      });
    });

    // Camera View Presets
    document.querySelectorAll('.btn-cam').forEach((btn) => {
      btn.addEventListener('click', () => {
        const camPreset = (btn as HTMLElement).dataset.cam;
        if (!activeAsset) return;
        const [x, y, z] = activeAsset.cameraDefaults.position;
        const dist = Math.sqrt(x * x + z * z);

        if (camPreset === 'three-quarter') {
          camera.position.set(dist * 0.7, y, dist * 0.7);
        } else if (camPreset === 'front') {
          camera.position.set(0, y * 0.85, dist);
        } else if (camPreset === 'side') {
          camera.position.set(dist * 1.1, y * 0.8, 0);
        } else if (camPreset === 'rear-three-quarter') {
          camera.position.set(-dist * 0.7, y, -dist * 0.7);
        } else if (camPreset === 'rear') {
          camera.position.set(0, y * 0.85, -dist);
        } else if (camPreset === 'top') {
          camera.position.set(0, dist * 1.3, 0.01);
        }
        controls.target.set(...activeAsset.cameraDefaults.target);
        controls.update();

        document.querySelectorAll('.btn-cam').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
      });
    });

    // Center / Reset Camera
    btnResetCam?.addEventListener('click', () => {
      if (!activeAsset) return;
      camera.position.set(...activeAsset.cameraDefaults.position);
      controls.target.set(...activeAsset.cameraDefaults.target);
      controls.update();
    });

    // Screenshot Capture
    btnExport?.addEventListener('click', () => {
      renderer.render(scene, camera);
      const dataUrl = renderer.domElement.toDataURL('image/png');
      const a = document.createElement('a');
      a.href = dataUrl;
      a.download = `${activeAsset?.assetId || 'custom-vehicle'}-colorcode.png`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    });

    // Undo / Redo
    btnUndo?.addEventListener('click', () => {
      if (undoStack.length === 0 || !activeAsset) return;
      const currentSnap = JSON.stringify(getVehicleConfig());
      redoStack.push(currentSnap);
      const prev = undoStack.pop();
      if (!prev) return;
      try {
        const cfg = JSON.parse(prev);
        vehicleConfigs[activeAsset.assetId] = cfg;
        applyConfigToModel(cfg);
      } catch (e) {}
    });

    btnRedo?.addEventListener('click', () => {
      if (redoStack.length === 0 || !activeAsset) return;
      const currentSnap = JSON.stringify(getVehicleConfig());
      undoStack.push(currentSnap);
      const next = redoStack.pop();
      if (!next) return;
      try {
        const cfg = JSON.parse(next);
        vehicleConfigs[activeAsset.assetId] = cfg;
        applyConfigToModel(cfg);
      } catch (e) {}
    });

    // Keyboard Shortcuts (Ctrl+Z / Ctrl+Y)
    window.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z') {
        e.preventDefault();
        if (e.shiftKey) {
          btnRedo?.click();
        } else {
          btnUndo?.click();
        }
      } else if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'y') {
        e.preventDefault();
        btnRedo?.click();
      }
    });

    // Toggle Before / After Factory Comparison
    btnToggleCompare?.addEventListener('click', () => {
      if (!activeAsset || !loadedVehicleObject) return;
      if (!isComparingFactory) {
        // Switch to Factory
        preCompareSnapshot = JSON.parse(JSON.stringify(getVehicleConfig()));
        const factoryCfg: Record<string, PanelColorState> = {};
        activeAsset.meshMappings.paintablePanels.forEach((p) => {
          factoryCfg[p.id] = {
            hex: p.defaultColor || '#DC2626',
            finish: p.defaultFinish || 'glossy',
            roughness: 0.18,
            metalness: 0.65,
            clearcoat: 1.0,
            clearcoatRoughness: 0.04
          };
        });
        applyConfigToModel(factoryCfg);
        isComparingFactory = true;
        btnToggleCompare.textContent = 'Original (Active)';
        btnToggleCompare.className = 'button button-small button-primary';
      } else {
        // Revert to Custom
        if (preCompareSnapshot) {
          vehicleConfigs[activeAsset.assetId] = preCompareSnapshot;
          applyConfigToModel(preCompareSnapshot);
        }
        isComparingFactory = false;
        btnToggleCompare.textContent = '⚖️ Before / After';
        btnToggleCompare.className = 'button button-small button-quiet';
      }
    });

    // Reset Single Panel
    btnResetPanel?.addEventListener('click', () => {
      if (!activePanelMapping || !activeAsset) return;
      recordHistory();
      const cfg = getVehicleConfig();
      const defaultHex = activePanelMapping.defaultColor || '#DC2626';
      const defaultFinish = activePanelMapping.defaultFinish || 'glossy';

      cfg[activePanelMapping.id] = {
        hex: defaultHex,
        finish: defaultFinish,
        roughness: 0.18,
        metalness: 0.65,
        clearcoat: 1.0,
        clearcoatRoughness: 0.04
      };

      if (activeMeshObject) {
        const mat = activeMeshObject.material as THREE.MeshPhysicalMaterial;
        mat.color.set(defaultHex);
        applyFinishToMaterial(mat, defaultFinish);
      }

      selectPanel(activePanelMapping);
      renderPanelChips();
      localStorage.setItem(`colorcode_studio_${activeAsset.assetId}`, JSON.stringify(cfg));
    });

    // Reset Vehicle (All Panels)
    btnResetVehicle?.addEventListener('click', () => {
      if (!activeAsset) return;
      recordHistory();
      const cfg: Record<string, PanelColorState> = {};
      activeAsset.meshMappings.paintablePanels.forEach((p) => {
        cfg[p.id] = {
          hex: p.defaultColor || '#DC2626',
          finish: p.defaultFinish || 'glossy',
          roughness: 0.18,
          metalness: 0.65,
          clearcoat: 1.0,
          clearcoatRoughness: 0.04
        };
      });
      vehicleConfigs[activeAsset.assetId] = cfg;
      applyConfigToModel(cfg);
      localStorage.removeItem(`colorcode_studio_${activeAsset.assetId}`);
    });

    function applyConfigToModel(cfg: Record<string, PanelColorState>) {
      if (!loadedVehicleObject || !activeAsset) return;
      loadedVehicleObject.traverse((child) => {
        if (child instanceof THREE.Mesh) {
          const pDef = activeAsset!.meshMappings.paintablePanels.find(
            (p) => p.nodeName === child.name || (p.nodeName === 'body' && child.name.toLowerCase().includes('body'))
          );
          if (pDef && cfg[pDef.id]) {
            const m = child.material as THREE.MeshPhysicalMaterial;
            m.color.set(cfg[pDef.id].hex);
            applyFinishToMaterial(m, cfg[pDef.id].finish, cfg[pDef.id].roughness, cfg[pDef.id].metalness, cfg[pDef.id].clearcoat);
          }
        }
      });
      if (activePanelMapping) selectPanel(activePanelMapping);
      renderPanelChips();
    }

    // =========================================================================
    // HIERARCHY SELECTORS LOGIC (Country -> Mfr -> Model -> Gen -> Year -> Variant)
    // =========================================================================
    function populateManufacturers() {
      if (!selectMfr) return;
      const search = inputSearchMfr?.value.toLowerCase().trim() || '';
      selectMfr.innerHTML = '';

      let mfrs = currentCountryCode === 'ALL'
        ? catalogue.flatMap((c) => c.manufacturers)
        : (catalogue.find((c) => c.code === currentCountryCode)?.manufacturers || []);

      if (search) {
        mfrs = mfrs.filter((m) => m.name.toLowerCase().includes(search));
      }

      mfrs.forEach((m) => {
        const opt = document.createElement('option');
        opt.value = m.id;
        opt.textContent = `${m.name} (${m.country})`;
        opt.selected = m.id === currentMfrId;
        selectMfr.appendChild(opt);
      });

      if (!mfrs.find((m) => m.id === currentMfrId) && mfrs.length > 0) {
        currentMfrId = mfrs[0].id;
      }
      populateModels();
    }

    function populateModels() {
      if (!selectModel) return;
      const search = inputSearchModel?.value.toLowerCase().trim() || '';
      selectModel.innerHTML = '';

      const allMfrs = catalogue.flatMap((c) => c.manufacturers);
      const mfr = allMfrs.find((m) => m.id === currentMfrId);
      if (!mfr) return;

      let models = mfr.models;
      if (currentCategoryFilter !== 'all') {
        models = models.filter((m) => m.category === currentCategoryFilter);
      }
      if (search) {
        models = models.filter((m) => m.name.toLowerCase().includes(search));
      }

      models.forEach((m) => {
        const opt = document.createElement('option');
        opt.value = m.id;
        const has3D = m.assetId && assetRegistry[m.assetId];
        opt.textContent = `${m.name} ${has3D ? '✓ 3D' : '⏳ Pending'}`;
        opt.selected = m.id === currentModelId;
        selectModel.appendChild(opt);
      });

      if (!models.find((m) => m.id === currentModelId) && models.length > 0) {
        currentModelId = models[0].id;
      }
      populateGenerations();
    }

    function populateGenerations() {
      if (!selectGeneration) return;
      selectGeneration.innerHTML = '';

      const allMfrs = catalogue.flatMap((c) => c.manufacturers);
      const mfr = allMfrs.find((m) => m.id === currentMfrId);
      const model = mfr?.models.find((m) => m.id === currentModelId);
      if (!model || model.generations.length === 0) return;

      model.generations.forEach((g) => {
        const opt = document.createElement('option');
        opt.value = g.id;
        opt.textContent = `${g.name} (${g.code})`;
        opt.selected = g.id === currentGenId;
        selectGeneration.appendChild(opt);
      });

      currentGenId = selectGeneration.value || model.generations[0].id;
      populateYears();
    }

    function populateYears() {
      if (!selectYear) return;
      selectYear.innerHTML = '';

      const allMfrs = catalogue.flatMap((c) => c.manufacturers);
      const mfr = allMfrs.find((m) => m.id === currentMfrId);
      const model = mfr?.models.find((m) => m.id === currentModelId);
      const gen = model?.generations.find((g) => g.id === currentGenId);
      if (!gen || gen.years.length === 0) return;

      gen.years.forEach((yr) => {
        const opt = document.createElement('option');
        opt.value = String(yr);
        opt.textContent = String(yr);
        opt.selected = yr === currentYear;
        selectYear.appendChild(opt);
      });

      currentYear = Number(selectYear.value) || gen.years[0];
      populateVariants();
    }

    function populateVariants() {
      if (!selectVariant) return;
      selectVariant.innerHTML = '';

      const allMfrs = catalogue.flatMap((c) => c.manufacturers);
      const mfr = allMfrs.find((m) => m.id === currentMfrId);
      const model = mfr?.models.find((m) => m.id === currentModelId);
      const gen = model?.generations.find((g) => g.id === currentGenId);
      if (!gen || gen.variants.length === 0) return;

      gen.variants.forEach((v) => {
        const opt = document.createElement('option');
        opt.value = v.id;
        opt.textContent = `${v.name} (${v.trim})`;
        opt.selected = v.id === currentVariantId;
        selectVariant.appendChild(opt);
      });

      currentVariantId = selectVariant.value || gen.variants[0].id;
      updateVehicleDisplayAndAsset();
    }

    // Update specs, status card, and load asset or show unavailable notice
    function updateVehicleDisplayAndAsset() {
      const allMfrs = catalogue.flatMap((c) => c.manufacturers);
      const mfr = allMfrs.find((m) => m.id === currentMfrId);
      const model = mfr?.models.find((m) => m.id === currentModelId);
      const gen = model?.generations.find((g) => g.id === currentGenId);
      const variant = gen?.variants.find((v) => v.id === currentVariantId);

      if (!mfr || !model || !gen || !variant) return;

      // Update Spec Sheet
      if (specEngine) specEngine.textContent = variant.engineSpecs;
      if (specPower) specPower.textContent = `${variant.horsepower} HP`;
      if (specTorque) specTorque.textContent = `${variant.torqueNm} Nm`;
      if (specTrans) specTrans.textContent = variant.transmission;
      if (specDrive) specDrive.textContent = variant.drivetrain;

      if (badgeDrivetrain) badgeDrivetrain.textContent = variant.drivetrain;
      if (badgeTransmission) badgeTransmission.textContent = variant.transmission;

      // Check if 3D Asset is Available
      const assetId = model.assetId;
      const asset = assetId ? assetRegistry[assetId] : null;

      if (asset && asset.license.verificationStatus === 'approved') {
        if (statusDot) {
          statusDot.className = 'status-pulse-dot';
        }
        if (statusTitle) statusTitle.textContent = 'Licensed 3D Model Verified';
        if (statusDesc) statusDesc.textContent = `Asset approved under ${asset.license.licenseType}. Independent panels ready.`;
        if (unavailableBanner) unavailableBanner.style.display = 'none';

        loadAssetModel(asset);
      } else {
        // Model unavailable in 3D
        if (statusDot) {
          statusDot.className = 'status-pulse-dot is-pending';
        }
        if (statusTitle) statusTitle.textContent = '3D Licensing Verification In Progress';
        if (statusDesc) statusDesc.textContent = 'To respect OEM trademark & design rights, asset is queued for CAD clearance.';

        if (unavailableBanner) {
          unavailableBanner.style.display = 'flex';
          if (unavailTitle) unavailTitle.textContent = `${mfr.name} ${model.name} (${currentYear})`;
          if (unavailDesc) {
            unavailDesc.textContent = `To strictly uphold automotive trademark standards and avoid unverified 3D representations, manufacturer-specific CAD geometry for ${mfr.name} ${model.name} (${currentYear}) is undergoing legal license verification.`;
          }
          if (unavailAttribution) {
            unavailAttribution.textContent = `OEM: ${mfr.name} (${mfr.country}) — Vehicle: ${model.name} (${gen.code}) — Status: Licensing verification pipeline.`;
          }
        }

        if (vpBadgeStatus) {
          vpBadgeStatus.textContent = '⏳ Curation Pending';
          vpBadgeStatus.className = 'badge badge-warning';
        }
        if (vpLicenseTag) {
          vpLicenseTag.textContent = 'OEM Legal Review';
        }
        if (vpVehicleName) {
          vpVehicleName.textContent = `${mfr.name} ${model.name} (${variant.name})`;
        }
      }

      // Persist selection locally
      localStorage.setItem('colorcode_last_vehicle', JSON.stringify({
        countryCode: currentCountryCode,
        mfrId: currentMfrId,
        modelId: currentModelId,
        genId: currentGenId,
        year: currentYear,
        variantId: currentVariantId
      }));
    }

    // Selector Event Listeners
    selectCountry?.addEventListener('change', (e) => {
      currentCountryCode = (e.target as HTMLSelectElement).value;
      if (badgeCountryName) {
        const country = catalogue.find((c) => c.code === currentCountryCode);
        badgeCountryName.textContent = country ? country.name : 'Worldwide';
      }
      populateManufacturers();
    });

    inputSearchMfr?.addEventListener('input', () => {
      populateManufacturers();
    });

    selectMfr?.addEventListener('change', (e) => {
      currentMfrId = (e.target as HTMLSelectElement).value;
      populateModels();
    });

    inputSearchModel?.addEventListener('input', () => {
      populateModels();
    });

    selectModel?.addEventListener('change', (e) => {
      currentModelId = (e.target as HTMLSelectElement).value;
      populateGenerations();
    });

    selectGeneration?.addEventListener('change', (e) => {
      currentGenId = (e.target as HTMLSelectElement).value;
      populateYears();
    });

    selectYear?.addEventListener('change', (e) => {
      currentYear = Number((e.target as HTMLSelectElement).value);
      populateVariants();
    });

    selectVariant?.addEventListener('change', (e) => {
      currentVariantId = (e.target as HTMLSelectElement).value;
      updateVehicleDisplayAndAsset();
    });

    // Category Filter Pills
    document.querySelectorAll('.cat-pill').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.cat-pill').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        currentCategoryFilter = (btn as HTMLElement).dataset.category || 'all';
        populateModels();
      });
    });

    // Quick Vehicles Buttons
    document.querySelectorAll('.btn-quick-vehicle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const mfr = (btn as HTMLElement).dataset.mfr;
        const model = (btn as HTMLElement).dataset.model;
        if (mfr && model) {
          currentCountryCode = 'ALL';
          if (selectCountry) selectCountry.value = 'ALL';
          currentMfrId = mfr;
          currentModelId = model;
          populateManufacturers();
        }
      });
    });

    // Fallback Button Action
    btnLoadFallback?.addEventListener('click', () => {
      currentCountryCode = 'IT';
      currentMfrId = 'ferrari';
      currentModelId = 'ferrari-458-italia';
      if (selectCountry) selectCountry.value = 'IT';
      populateManufacturers();
    });

    // Responsive Canvas Resize
    function handleResize() {
      if (!canvasContainer) return;
      const width = canvasContainer.clientWidth;
      const height = canvasContainer.clientHeight;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    }
    window.addEventListener('resize', handleResize);

    // Initial Hierarchy Population
    // Check if user has last selected vehicle in localStorage
    const savedVehicle = localStorage.getItem('colorcode_last_vehicle');
    if (savedVehicle) {
      try {
        const parsed = JSON.parse(savedVehicle);
        if (parsed.countryCode) currentCountryCode = parsed.countryCode;
        if (parsed.mfrId) currentMfrId = parsed.mfrId;
        if (parsed.modelId) currentModelId = parsed.modelId;
        if (parsed.genId) currentGenId = parsed.genId;
        if (parsed.year) currentYear = parsed.year;
        if (parsed.variantId) currentVariantId = parsed.variantId;
        if (selectCountry) selectCountry.value = currentCountryCode;
      } catch (e) {}
    }

    populateManufacturers();

    // 60FPS Animation Loop with Controls Damping
    function animate() {
      requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    }
    animate();
  }
</script>
