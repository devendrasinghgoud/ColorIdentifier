---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Color Palette Generator — Create a Matching Color Palette" description="Create a simple five-color palette from a base HEX color. Explore generated tints, shades and complementary color relationships."><div class="container"><div class="page-hero"><div class="breadcrumbs"><a href="/">Home</a> / Color Palette Generator</div><span class="eyebrow">Color creation tool</span><h1>Color Palette Generator</h1><p>Choose a starting color and create a simple palette of related shades and a complementary accent.</p></div><div class="converter-card"><div class="field"><label for="palette-base">Base HEX color</label><input id="palette-base" value="#6C5CE7" /></div><div id="palette-strip" class="color-strip"></div><div id="palette-values" class="sampled-swatches"></div><button id="regenerate-palette" class="button button-primary" type="button">Generate palette</button><p id="palette-error" class="scanner-message" role="status"></p></div><article class="prose"><h2>How this palette works</h2><p>The generator uses the base color and creates a small range of lighter and darker colors, plus a complementary hue. This is a quick starting point; check contrast and test colors in their actual design context before using them.</p><p>To sample a color from a photograph first, use the <a href="/color-identifier/">color identifier</a> or <a href="/image-color-picker/">image color picker</a>.</p></article></div></BaseLayout>
<script>
import { parseHex, rgbToHex, rgbToHsl, hslToRgb } from '../lib/color';
const input=document.querySelector<HTMLInputElement>('#palette-base');const strip=document.querySelector<HTMLElement>('#palette-strip');const values=document.querySelector<HTMLElement>('#palette-values');const error=document.querySelector<HTMLElement>('#palette-error');
function generate(){const rgb=parseHex(input?.value||'');if(!rgb){if(error)error.textContent='Enter a valid HEX color first.';return;}const hsl=rgbToHsl(rgb);const colors=[hslToRgb({...hsl,l:Math.min(96,hsl.l+27)}),hslToRgb({...hsl,l:Math.min(82,hsl.l+13)}),rgb,hslToRgb({...hsl,l:Math.max(12,hsl.l-16)}),hslToRgb({h:(hsl.h+180)%360,s:hsl.s,l:hsl.l})].map(rgbToHex);if(strip){strip.innerHTML='';colors.forEach(c=>{const s=document.createElement('span');s.style.background=c;strip.append(s);});}if(values){values.innerHTML='';colors.forEach(c=>{const b=document.createElement('button');b.className='sample-chip';b.type='button';const s=document.createElement('span');s.style.background=c;const t=document.createElement('small');t.textContent=c;b.append(s,t);b.addEventListener('click',async()=>{await navigator.clipboard.writeText(c);t.textContent='Copied!';});values.append(b);});}if(error)error.textContent='';}
input?.addEventListener('input',generate);document.querySelector('#regenerate-palette')?.addEventListener('click',generate);generate();
</script>
