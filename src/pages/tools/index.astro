---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';

const tools = [
  {
    category: 'Vehicle Customizers & Paint Visualizers',
    items: [
      { title: '3D Vehicle Color Customizer', desc: 'Interactive 3D WebGL vehicle painter. Rotate 360° and color panels independently with gloss, metallic, and matte shaders.', href: '/3d-vehicle-customizer/', icon: '🎮' },
      { title: 'Car Color Customizer', desc: 'Preview any color on sedans, SUVs, trucks, or upload your own car photo.', href: '/car-color-customizer/', icon: '🚘' },
      { title: 'Motorcycle Color Customizer', desc: 'Visualize colors on sport bikes, cruisers, naked bikes, or uploaded photos.', href: '/bike-color-customizer/', icon: '🏍️' },
      { title: 'Car Paint Preview & Sprayouts', desc: 'Compare virtual sprayout finishes: metallic flake, pearl, matte, and gloss.', href: '/car-paint-color-preview/', icon: '✨' },
      { title: 'Motorcycle Paint & Wrap Preview', desc: 'Preview multi-stage candy glazes, tank wraps, and racing liveries.', href: '/motorcycle-paint-color-preview/', icon: '🏁' }
    ]
  },
  {
    category: 'Identification & Scanners',
    items: [
      { title: 'Color Scanner & Identifier', desc: 'Sample colors in real time with your camera or from photos.', href: '/color-identifier/', icon: '📷' },
      { title: 'Image Color Picker', desc: 'Precision pixel loupe magnifier to sample any point on an image.', href: '/image-color-picker/', icon: '🔍' },
      { title: 'Car Paint Color Identifier', desc: 'Identify visible car paint colors and match verified OEM codes.', href: '/car-color-identifier/', icon: '🚗' },
      { title: 'Motorcycle Paint Identifier', desc: 'Sample fuel tanks and fairings with motorcycle factory paint codes.', href: '/bike-color-identifier/', icon: '🏍️' },
      { title: 'Vehicle Paint Code Guide', desc: 'Find paint code label locations across car manufacturers.', href: '/car-paint-color-codes/', icon: '🏷️' }
    ]
  },
  {
    category: 'Analysis & Accessibility',
    items: [
      { title: 'WCAG Contrast Checker', desc: 'Check text and background contrast against WCAG AA & AAA ratios.', href: '/color-contrast-checker/', icon: '◐' },
      { title: 'Color Blindness Simulator', desc: 'Simulate Protanopia, Deuteranopia, Tritanopia, and Achromatopsia.', href: '/color-blindness-simulator/', icon: '👁️' },
      { title: 'Color Temperature Analyzer', desc: 'Analyze warm vs cool color tones and Correlated Color Temperature (Kelvin).', href: '/color-temperature-analyzer/', icon: '🌡️' }
    ]
  },
  {
    category: 'Palette Generation & Harmonies',
    items: [
      { title: 'Complementary Color Finder', desc: 'Calculate complementary, split, analogous, and triadic schemes.', href: '/complementary-color-finder/', icon: '🎨' },
      { title: 'Color Palette Extractor', desc: 'Extract dominant cohesive palettes directly from photos.', href: '/color-palette-extractor/', icon: '▦' },
      { title: 'Color Palette Generator', desc: 'Generate coordinated palettes and visual harmonies from a starting shade.', href: '/color-palette-generator/', icon: '✨' },
      { title: 'Color Shades Generator', desc: 'Generate a stepped tonal range of lighter and darker variations.', href: '/color-shades-generator/', icon: '📶' },
      { title: 'Color Mixer & Blender', desc: 'Blend two colors with customized percentage ratios and CSS output.', href: '/color-mixer/', icon: '🧪' },
      { title: 'CSS Gradient Generator', desc: 'Design smooth multi-color linear gradients and copy CSS code.', href: '/gradient-generator/', icon: '🌈' }
    ]
  },
  {
    category: 'Format Conversion & Reference',
    items: [
      { title: 'Color Database 2.0', desc: 'Search 80+ named colors with family, temperature, and tone filters.', href: '/color-names/', icon: '📚' },
      { title: 'HEX to RGB Converter', desc: 'Convert HEX color codes into RGB and HSL formats.', href: '/hex-to-rgb/', icon: '↔' },
      { title: 'RGB to HEX Converter', desc: 'Convert red, green, and blue channel numbers to HEX codes.', href: '/rgb-to-hex/', icon: '🔀' },
      { title: 'Color Name Finder', desc: 'Find the closest curated name and family for any HEX value.', href: '/color-name-finder/', icon: '✳' },
      { title: 'HTML Color Codes Reference', desc: 'Browse standard CSS and HTML color names with live swatches.', href: '/html-color-codes/', icon: '📋' }
    ]
  }
];

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Free Online Color Tools — ColorCode Identifier',
  description: 'Comprehensive suite of free color tools: vehicle customizers, camera scanners, vehicle paint matchers, WCAG contrast checkers, and format converters.'
};
---

<BaseLayout
  title="Free Color Tools Directory — Scanners, Customizers & Converters"
  description="Explore our full collection of free color tools: car and bike color customizers, camera color scanner, WCAG contrast checker, palette extractor, and converters."
>
  <JsonLd data={pageSchema} />

  <div class="container">
    <div class="page-hero">
      <div class="breadcrumbs">
        <a href="/">Home</a> / All Tools
      </div>
      <span class="eyebrow">Comprehensive Color Toolkit</span>
      <h1>All Free Color Tools & Utilities</h1>
      <p>Discover professional browser-native tools to customize vehicles, identify real-world pixels, convert formats, and analyze color harmony.</p>
    </div>

    {tools.map((section) => (
      <section class="section" style="padding-top:24px;padding-bottom:12px;">
        <h2 style="font-size:22px;letter-spacing:-0.03em;color:var(--ink);margin-bottom:16px;">{section.category}</h2>
        <div class="tool-grid">
          {section.items.map((tool) => (
            <a class="tool-card" href={tool.href}>
              <div class="tool-icon">{tool.icon}</div>
              <h3>{tool.title}</h3>
              <p>{tool.desc}</p>
              <span class="tool-arrow">Open tool →</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
