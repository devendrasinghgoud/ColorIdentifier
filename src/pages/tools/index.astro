---
import BaseLayout from '../../layouts/BaseLayout.astro';
const tools=[['Color Identifier','Sample colors from a camera or photo.','/color-identifier/'],['Car Color Identifier','Identify visible car paint colors.','/car-color-identifier/'],['Bike Color Identifier','Sample motorcycle body colors.','/bike-color-identifier/'],['Image Color Picker','Pick a pixel from an uploaded image.','/image-color-picker/'],['HEX to RGB','Convert HEX to RGB and HSL.','/hex-to-rgb/'],['RGB to HEX','Convert RGB channels to HEX.','/rgb-to-hex/'],['Color Name Finder','Find the nearest name in a color list.','/color-name-finder/'],['Color Palette Generator','Generate a simple coordinated palette.','/color-palette-generator/'],['Color Contrast Checker','Check WCAG contrast ratios.','/color-contrast-checker/'],['Color Shades Generator','Create lighter and darker color variations.','/color-shades-generator/'],['Gradient Generator','Create and copy CSS linear gradients.','/gradient-generator/'],['HTML Color Codes','Browse common named colors.','/html-color-codes/']];
---
<BaseLayout title="Free Color Tools — Color Identifier, Converters and More" description="Explore free color tools for identifying, sampling, converting and comparing colors. Use the camera, upload an image or work with HEX and RGB values."><div class="container"><div class="page-hero"><div class="breadcrumbs"><a href="/">Home</a> / Tools</div><span class="eyebrow">Color utility toolkit</span><h1>All Color Tools</h1><p>Choose a tool to identify, sample, convert and explore digital colors.</p></div><div class="tool-grid section" style="padding-top:15px">{tools.map(([title,desc,href])=><a class="tool-card" href={href}><div class="tool-icon">✳</div><h3>{title}</h3><p>{desc}</p><span class="tool-arrow">Open tool →</span></a>)}</div></div></BaseLayout>
