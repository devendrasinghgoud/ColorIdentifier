---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Color Shades Generator — Create Lighter and Darker Shades" description="Generate lighter and darker shades from a HEX color. Preview a tonal scale and copy each color value for design work."><div class="container"><div class="page-hero"><div class="breadcrumbs"><a href="/">Home</a> / Color Shades Generator</div><span class="eyebrow">Color creation tool</span><h1>Color Shades Generator</h1><p>Enter a base HEX color to create a useful range of lighter and darker variations.</p></div><div class="converter-card"><div class="field"><label for="shade-base">Base HEX color</label><input id="shade-base" value="#6C5CE7" /></div><div id="shade-output" class="color-strip"></div><div id="shade-values" class="sampled-swatches"></div><p id="shade-error" class="scanner-message" role="status"></p></div><p class="prose">Start with a color sampled using the <a href="/color-identifier/">color identifier</a> or a color from our <a href="/color-names/">color reference library</a>.</p></div></BaseLayout>
<script>
import {parseHex,rgbToHsl,hslToRgb,rgbToHex} from '../lib/color';
const input=document.querySelector<HTMLInputElement>('#shade-base'),strip=document.querySelector<HTMLElement>('#shade-output'),values=document.querySelector<HTMLElement>('#shade-values'),error=document.querySelector<HTMLElement>('#shade-error');
function update(){const rgb=parseHex(input?.value||'');if(!rgb){if(error)error.textContent='Enter a valid HEX color.';return;}const h=rgbToHsl(rgb);const shades=[96,88,78,68,h.l,Math.max(8,h.l-14),Math.max(5,h.l-28)].map(l=>rgbToHex(hslToRgb({...h,l})));if(strip){strip.innerHTML='';shades.forEach(c=>{const s=document.createElement('span');s.style.background=c;strip.append(s);});}if(values){values.innerHTML='';shades.forEach(c=>{const b=document.createElement('button');b.className='sample-chip';b.type='button';const s=document.createElement('span');s.style.background=c;const t=document.createElement('small');t.textContent=c;b.append(s,t);b.onclick=async()=>{try{await navigator.clipboard.writeText(c);t.textContent='Copied!';}catch{t.textContent='Select '+c;}};values.append(b);});}if(error)error.textContent='';}input?.addEventListener('input',update);update();
</script>
