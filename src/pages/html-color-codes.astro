---
import BaseLayout from '../layouts/BaseLayout.astro'; import { NAMED_COLORS } from '../data/colors';
---
<BaseLayout title="HTML Color Codes — Named Colors and HEX Values" description="Browse a curated set of common HTML-style named colors with HEX values and visual swatches. Use the values in web design and CSS."><div class="container"><div class="page-hero"><div class="breadcrumbs"><a href="/">Home</a> / HTML Color Codes</div><span class="eyebrow">Color reference library</span><h1>HTML Color Codes</h1><p>Explore a curated set of common named colors and their HEX values. Select a color to use it as a starting point in your design.</p></div><div class="color-reference-grid section" style="padding-top:10px">{NAMED_COLORS.map(c=><a class="color-reference" href={`/colors/${c.name.toLowerCase().replaceAll(' ','-')}/`}><div class="color-reference-swatch" style={`background:${c.hex}`}></div><div class="color-reference-body"><strong>{c.name}</strong><code>{c.hex}</code></div></a>)}</div><p class="muted">This is a starter reference set, not a complete specification of every CSS named color.</p></div></BaseLayout>
