---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';

const toolSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Color Blindness Simulator',
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Any',
  description: 'Simulate how colors and images appear to people with Protanopia, Deuteranopia, Tritanopia, and Achromatopsia.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
};

const conditions = [
  { id: 'normal', name: 'Normal Trichromacy', desc: 'Standard color vision with all three cone types functioning.' },
  { id: 'protanopia', name: 'Protanopia (Red-Blind)', desc: 'Absence of long-wavelength (L) red cone photoreceptors (~1% of males).' },
  { id: 'deuteranopia', name: 'Deuteranopia (Green-Blind)', desc: 'Absence of medium-wavelength (M) green cone photoreceptors (~1% of males).' },
  { id: 'tritanopia', name: 'Tritanopia (Blue-Blind)', desc: 'Rare absence of short-wavelength (S) blue cone photoreceptors (<0.1%).' },
  { id: 'achromatopsia', name: 'Achromatopsia (Monochromacy)', desc: 'Complete inability to perceive color; vision is purely in shades of gray.' }
];

const faq = [
  {
    q: 'How common is color vision deficiency?',
    a: 'Approximately 1 in 12 men (8%) and 1 in 200 women (0.5%) have some form of color vision deficiency. Red-green types (deuteranomaly and protanomaly) are by far the most prevalent.'
  },
  {
    q: 'How can designers ensure accessibility for color-blind users?',
    a: 'Never rely on color alone to communicate essential state or instructions. Always combine colors with text labels, icons, patterns, or distinct geometric shapes, and maintain high luminance contrast.'
  }
];
---

<BaseLayout
  title="Color Blindness Simulator — Test Colors & Images for Accessibility"
  description="Simulate how your colors and images are perceived by individuals with Protanopia, Deuteranopia, Tritanopia, and Achromatopsia using accurate matrix transformations."
>
  <JsonLd data={toolSchema} />

  <div class="container">
    <div class="page-hero">
      <div class="breadcrumbs">
        <a href="/">Home</a> / <a href="/tools/">Tools</a> / Color Blindness Simulator
      </div>
      <span class="eyebrow">Accessibility & Inclusion Tool</span>
      <h1>Color Blindness Simulator</h1>
      <p>Test individual colors or upload design graphics to see how they appear under common color vision deficiencies.</p>
    </div>

    <div class="converter-card" style="max-width:100%;margin-bottom:28px;">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:16px;">
        <div class="field" style="margin:0;min-width:240px;">
          <label for="color-input">Test a single HEX color:</label>
          <div style="display:flex;gap:8px;">
            <input id="picker" type="color" value="#6C5CE7" style="width:48px;height:42px;padding:2px;border-radius:8px;" />
            <input id="color-input" value="#6C5CE7" placeholder="#6C5CE7" style="max-width:140px;" />
          </div>
        </div>
        <div>
          <label class="button button-primary upload-button button-small" for="sim-image-file">
            📁 Or upload an image to simulate
          </label>
          <input id="sim-image-file" type="file" accept="image/*" hidden />
        </div>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));gap:14px;margin-top:20px;">
        {conditions.map((c) => (
          <div class="tool-card" style="padding:16px;">
            <span class="eyebrow" style="font-size:10px;">{c.id.toUpperCase()}</span>
            <h3 style="font-size:14px;margin:4px 0 8px;">{c.name}</h3>
            <div id={`swatch-${c.id}`} style="height:60px;border-radius:10px;background:#6C5CE7;border:1px solid var(--border);margin-bottom:8px;"></div>
            <strong id={`hex-${c.id}`} style="font-size:12px;font-family:monospace;display:block;">#6C5CE7</strong>
            <p style="font-size:11px;color:var(--muted);margin-top:6px;">{c.desc}</p>
          </div>
        ))}
      </div>

      <div id="image-simulation-area" style="display:none;margin-top:28px;border-top:1px solid var(--border);padding-top:20px;">
        <h3 style="font-size:16px;margin:0 0 14px;color:var(--ink);">Image Simulation Across Vision Profiles</h3>
        <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(240px, 1fr));gap:14px;">
          <div>
            <span class="tag-badge">Normal Vision</span>
            <canvas id="canvas-normal" style="width:100%;height:auto;border-radius:10px;margin-top:8px;border:1px solid var(--border);"></canvas>
          </div>
          <div>
            <span class="tag-badge">Protanopia (Red-Blind)</span>
            <canvas id="canvas-protanopia" style="width:100%;height:auto;border-radius:10px;margin-top:8px;border:1px solid var(--border);"></canvas>
          </div>
          <div>
            <span class="tag-badge">Deuteranopia (Green-Blind)</span>
            <canvas id="canvas-deuteranopia" style="width:100%;height:auto;border-radius:10px;margin-top:8px;border:1px solid var(--border);"></canvas>
          </div>
          <div>
            <span class="tag-badge">Tritanopia (Blue-Blind)</span>
            <canvas id="canvas-tritanopia" style="width:100%;height:auto;border-radius:10px;margin-top:8px;border:1px solid var(--border);"></canvas>
          </div>
          <div>
            <span class="tag-badge">Achromatopsia (Monochrome)</span>
            <canvas id="canvas-achromatopsia" style="width:100%;height:auto;border-radius:10px;margin-top:8px;border:1px solid var(--border);"></canvas>
          </div>
        </div>
      </div>
    </div>

    <div class="content-layout">
      <article class="prose">
        <h2>Understanding Color Blindness Types</h2>
        <p>
          Human color vision relies on three photopigments located in retinal cone cells:
          L-cones (sensitive to red wavelengths), M-cones (sensitive to green), and S-cones (sensitive to blue).
          When one cone type is absent or has an altered absorption spectrum, color perception changes predictably.
        </p>

        <h3>1. Protanopia</h3>
        <p>
          L-cones are completely missing. Sufferers cannot distinguish between reds and greens, and deep reds appear very dark or black.
        </p>

        <h3>2. Deuteranopia</h3>
        <p>
          M-cones are absent. Reds, greens, browns, and oranges tend to blend into similar yellowish-khaki hues.
        </p>

        <h3>3. Tritanopia</h3>
        <p>
          S-cones are absent. Blues look greenish, and yellows appear light gray or violet.
        </p>

        <h3>4. Achromatopsia</h3>
        <p>
          Complete absence of cone function. Vision relies solely on retinal rods, resulting in complete color blindness and light sensitivity.
        </p>

        <h2>Frequently Asked Questions</h2>
        <div class="faq-list">
          {faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </article>

      <aside class="sidebar-card">
        <h3>Accessibility Tools</h3>
        <a href="/color-contrast-checker/">Color Contrast Checker</a>
        <a href="/color-mixer/">Color Mixer</a>
        <a href="/color-identifier/">Identify Colors from Photo</a>
        <a href="/blog/what-is-wcag-color-contrast/">WCAG Guidelines Guide</a>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  import { parseHex, simulateColorBlindness, rgbToHex } from '../lib/color';

  const colorInput = document.querySelector<HTMLInputElement>('#color-input');
  const picker = document.querySelector<HTMLInputElement>('#picker');
  const fileInput = document.querySelector<HTMLInputElement>('#sim-image-file');
  const imgArea = document.querySelector<HTMLElement>('#image-simulation-area');

  function updateSwatches() {
    const parsed = parseHex(colorInput?.value || '#6C5CE7');
    if (!parsed) return;

    const normalHex = rgbToHex(parsed);
    const protHex = rgbToHex(simulateColorBlindness(parsed, 'protanopia'));
    const deutHex = rgbToHex(simulateColorBlindness(parsed, 'deuteranopia'));
    const tritHex = rgbToHex(simulateColorBlindness(parsed, 'tritanopia'));
    const achrHex = rgbToHex(simulateColorBlindness(parsed, 'achromatopsia'));

    const setCard = (id: string, hex: string) => {
      const sw = document.querySelector<HTMLElement>(`#swatch-${id}`);
      const hx = document.querySelector<HTMLElement>(`#hex-${id}`);
      if (sw) sw.style.background = hex;
      if (hx) hx.textContent = hex;
    };

    setCard('normal', normalHex);
    setCard('protanopia', protHex);
    setCard('deuteranopia', deutHex);
    setCard('tritanopia', tritHex);
    setCard('achromatopsia', achrHex);
  }

  colorInput?.addEventListener('input', () => {
    const p = parseHex(colorInput.value);
    if (p && picker) picker.value = colorInput.value;
    updateSwatches();
  });

  picker?.addEventListener('input', () => {
    if (colorInput) colorInput.value = picker.value;
    updateSwatches();
  });

  fileInput?.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (!file) return;

    const img = new Image();
    const url = URL.createObjectURL(file);
    img.onload = () => {
      if (imgArea) imgArea.style.display = 'block';

      const maxDim = 400;
      const scale = Math.min(1, maxDim / Math.max(img.width, img.height));
      const w = Math.round(img.width * scale);
      const h = Math.round(img.height * scale);

      const renderSim = (canvasId: string, type: 'normal' | 'protanopia' | 'deuteranopia' | 'tritanopia' | 'achromatopsia') => {
        const c = document.querySelector<HTMLCanvasElement>(`#canvas-${canvasId}`);
        if (!c) return;
        c.width = w;
        c.height = h;
        const ctx = c.getContext('2d');
        if (!ctx) return;

        ctx.drawImage(img, 0, 0, w, h);
        if (type === 'normal') return;

        const imgData = ctx.getImageData(0, 0, w, h);
        const data = imgData.data;
        for (let i = 0; i < data.length; i += 4) {
          const sim = simulateColorBlindness({ r: data[i], g: data[i + 1], b: data[i + 2] }, type);
          data[i] = sim.r;
          data[i + 1] = sim.g;
          data[i + 2] = sim.b;
        }
        ctx.putImageData(imgData, 0, 0);
      };

      renderSim('normal', 'normal');
      renderSim('protanopia', 'protanopia');
      renderSim('deuteranopia', 'deuteranopia');
      renderSim('tritanopia', 'tritanopia');
      renderSim('achromatopsia', 'achromatopsia');
      URL.revokeObjectURL(url);
    };
    img.src = url;
  });

  updateSwatches();
</script>
