---
import BaseLayout from '../layouts/BaseLayout.astro';
import ColorIdentifier from '../components/ColorIdentifier.astro';
import { SITE } from '../data/site';
import { getCollection } from 'astro:content';
import JsonLd from '../components/JsonLd.astro';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b) => b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,3);
const appSchema = { '@context':'https://schema.org', '@type':'WebApplication', name:SITE.name, applicationCategory:'UtilitiesApplication', operatingSystem:'Any', browserRequirements:'Requires a modern browser; camera access requires HTTPS and permission.', description:SITE.description, offers:{'@type':'Offer',price:'0',priceCurrency:'USD'} };
const tools = [
  ['Car Color Identifier','Identify visible car paint colors from a photo or camera.','/car-color-identifier/','🚘'],
  ['Bike Color Identifier','Sample motorcycle tanks, fairings and painted panels.','/bike-color-identifier/','🏍️'],
  ['HEX to RGB Converter','Convert HEX values into RGB and HSL color formats.','/hex-to-rgb/','↔'],
  ['Color Name Finder','Find the closest name in our curated color reference.','/color-name-finder/','✳'],
  ['Color Palette Generator','Explore coordinated colors from a starting shade.','/color-palette-generator/','▦'],
  ['Color Contrast Checker','Check text and background contrast against WCAG ratios.','/color-contrast-checker/','◐']
];
---
<BaseLayout title="Identify Colors from Camera or Photo" description="Identify car, bike and everyday colors from a camera or uploaded photo. Sample pixels, view HEX, RGB and HSL values, and explore free color tools.">
  <JsonLd data={appSchema} />
  <section class="hero"><div class="container hero-grid"><div><span class="eyebrow">A practical color discovery toolkit</span><h1>Find the color.<br/><span class="gradient-text">Know the code.</span></h1><p class="hero-copy">Identify visible colors from a car, bike, product or everyday object. Use your camera or upload a photo to sample a color and explore its values.</p><div class="hero-actions"><a class="button button-primary" href="#color-scanner">Start identifying <span aria-hidden="true">↗</span></a><a class="button button-secondary" href="/car-color-identifier/">Explore car colors</a></div><p class="muted" style="margin-top:14px">Free to use · No account required · Image processing in your browser</p></div><div class="hero-visual" aria-label="Illustration of sampling a blue car paint color"><div class="visual-top"><span>COLOR SAMPLE PREVIEW</span><span class="live-pill">● SAMPLE READY</span></div><div class="visual-photo"><span class="visual-crosshair"></span></div><div class="visual-meta"><span class="visual-swatch"></span><div><strong>Deep metallic blue</strong><small>#315D91 · RGB 49, 93, 145</small></div></div></div></div></section>
  <section class="section" id="color-scanner"><div class="container"><div class="section-heading"><div><span class="eyebrow">The main experience</span><h2>Identify a color from any photo</h2><p>Upload a picture or enable your device camera. Select a point on the image to read its visible color values.</p></div></div><ColorIdentifier /></div></section>
  <section class="section"><div class="container"><div class="section-heading"><div><span class="eyebrow">Built around real use cases</span><h2>Start with what you're identifying</h2><p>Purpose-built guides for vehicle colors, with general-purpose color tools alongside them.</p></div></div><div class="tool-grid"><a class="tool-card" href="/car-color-identifier/"><div class="tool-icon">🚘</div><h3>Car color identifier</h3><p>Sample visible paint colors from car photos and explore close visual matches.</p><span class="tool-arrow">Explore car colors →</span></a><a class="tool-card" href="/bike-color-identifier/"><div class="tool-icon">🏍️</div><h3>Bike color identifier</h3><p>Identify colors from motorcycle tanks, panels and fairings.</p><span class="tool-arrow">Explore bike colors →</span></a><a class="tool-card" href="/image-color-picker/"><div class="tool-icon">▧</div><h3>Image color picker</h3><p>Sample a specific pixel from an uploaded image.</p><span class="tool-arrow">Pick a color →</span></a></div></div></section>
  <section class="section"><div class="container"><div class="section-heading"><div><span class="eyebrow">More ways to explore</span><h2>Color tools for every project</h2><p>Convert values, compare shades and make more informed color choices.</p></div><a href="/tools/">View all tools →</a></div><div class="tool-grid">{tools.map(([name,desc,href,icon])=><a class="tool-card" href={href}><div class="tool-icon">{icon}</div><h3>{name}</h3><p>{desc}</p><span class="tool-arrow">Open tool →</span></a>)}</div></div></section>
  <section class="section"><div class="container"><div class="soft-panel"><span class="eyebrow">A note about paint accuracy</span><h2>A sampled color is a visual reference, not a factory paint formula.</h2><p>Camera sensors, lighting, reflections, metallic flakes and display settings can change how a vehicle color appears in a photo. Use our HEX, RGB and HSL values as digital references. For a true automotive repaint, verify the manufacturer's paint code and consult a paint professional.</p><a class="button button-secondary" href="/car-paint-color-codes/">Learn about vehicle paint codes</a></div></div></section>
  {posts.length > 0 && <section class="section"><div class="container"><div class="section-heading"><div><span class="eyebrow">Learn about color</span><h2>Latest color guides</h2><p>Practical explanations to help you identify, compare and use colors.</p></div><a href="/blog/">Visit the blog →</a></div><div class="article-grid">{posts.map(post=><a class="article-card" href={`/blog/${post.id}/`}><div class="article-card-body"><span class="article-tag">{post.data.category}</span><h3>{post.data.title}</h3><p>{post.data.description}</p><div class="article-meta" style="margin-top:13px">{post.data.pubDate.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})}</div></div></a>)}</div></div></section>}
</BaseLayout>
