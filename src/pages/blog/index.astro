---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import JsonLd from '../../components/JsonLd.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categories = ['All', ...new Set(posts.map((p) => p.data.category))];

const blogIndexSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Color Guides, Automotive Paint & Design Tutorials',
  description: 'Practical guides to identifying colors from photos, understanding digital color models, automotive paint matching, and WCAG accessibility standards.'
};
---

<BaseLayout
  title="Color Guides, Automotive Paint & Tutorials — ColorCode Identifier"
  description="Explore in-depth tutorials on digital color identification, camera scanning, automotive OEM paint codes, WCAG contrast standards, and color theory."
>
  <JsonLd data={blogIndexSchema} />

  <div class="container">
    <div class="page-hero">
      <div class="breadcrumbs">
        <a href="/">Home</a> / Blog
      </div>
      <span class="eyebrow">Color Knowledge Hub</span>
      <h1>Color Guides, Automotive Paint & Tutorials</h1>
      <p>Practical, authoritative guides on sampling physical colors, decoding manufacturer paint codes, and mastering digital color theory.</p>
    </div>

    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:24px;">
      {categories.map((cat) => (
        <button
          class="button button-secondary button-small cat-filter-btn"
          data-category={cat}
          type="button"
        >
          {cat}
        </button>
      ))}
    </div>

    <div class="article-grid" id="blog-grid" style="padding-top:0;">
      {posts.map((post) => {
        const bodyText = post.body || '';
        const wordCount = bodyText.split(/\s+/).length;
        const readTime = Math.max(2, Math.round(wordCount / 200));

        return (
          <a
            class="article-card blog-post-card"
            href={`/blog/${post.id}/`}
            data-cat={post.data.category}
          >
            <div class="article-card-body">
              <span class="article-tag">{post.data.category}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <div class="article-meta">
                <span>{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                <span> · </span>
                <span>{readTime} min read</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.cat-filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.blog-post-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-category');
      filterBtns.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('button-primary', active);
        b.classList.toggle('button-secondary', !active);
      });

      cards.forEach((card) => {
        const cardCat = card.getAttribute('data-cat');
        card.style.display = cat === 'All' || cardCat === cat ? '' : 'none';
      });
    });
  });

  // Default select first 'All' button
  if (filterBtns[0]) {
    filterBtns[0].classList.add('button-primary');
    filterBtns[0].classList.remove('button-secondary');
  }
</script>
