---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { getCollection } from 'astro:content';
const posts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<BaseLayout title="Color Guides and Tutorials" description="Learn how to identify colors from photos, understand HEX and RGB values, and use color tools for vehicles and digital design."><div class="container"><div class="page-hero"><div class="breadcrumbs"><a href="/">Home</a> / Blog</div><span class="eyebrow">Color learning center</span><h1>Color Guides & Tutorials</h1><p>Practical guides to identifying, understanding and working with colors in the real world and on screen.</p></div><div class="article-grid section" style="padding-top:10px">{posts.map(post=><a class="article-card" href={`/blog/${post.id}/`}><div class="article-card-body"><span class="article-tag">{post.data.category}</span><h3>{post.data.title}</h3><p>{post.data.description}</p><div class="article-meta" style="margin-top:14px">{post.data.pubDate.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})} · {post.data.author}</div></div></a>)}</div></div></BaseLayout>
