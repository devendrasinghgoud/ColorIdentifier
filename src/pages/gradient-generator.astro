---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="CSS Gradient Generator — Create and Copy Gradients" description="Create a simple two-color CSS linear gradient. Choose HEX colors, adjust the angle and copy the generated CSS."><div class="container"><div class="page-hero"><div class="breadcrumbs"><a href="/">Home</a> / Gradient Generator</div><span class="eyebrow">Color creation tool</span><h1>CSS Gradient Generator</h1><p>Choose two colors and an angle to preview a linear gradient and copy its CSS.</p></div><div class="converter-card"><div class="form-row"><div class="field"><label for="gradient-a">Start color</label><input id="gradient-a" value="#6C5CE7" /></div><div class="field"><label for="gradient-b">End color</label><input id="gradient-b" value="#22D3EE" /></div></div><div class="field" style="margin-top:14px"><label for="gradient-angle">Angle: <output id="angle-value">120°</output></label><input id="gradient-angle" type="range" min="0" max="360" value="120" /></div><div id="gradient-preview" style="height:130px;border-radius:14px;margin:18px 0;background:linear-gradient(120deg,#6C5CE7,#22D3EE)"></div><div class="field"><label for="gradient-css">CSS output</label><input id="gradient-css" readonly value="linear-gradient(120deg, #6C5CE7, #22D3EE)" /></div><button id="copy-gradient" class="button button-primary" type="button">Copy CSS</button><p id="gradient-error" class="scanner-message" role="status"></p></div><p class="prose">Need a starting shade? Use the <a href="/color-identifier/">color identifier</a> or <a href="/color-palette-generator/">palette generator</a>.</p></div></BaseLayout>
<script>
import {parseHex} from '../lib/color';
const a=document.querySelector<HTMLInputElement>('#gradient-a'),b=document.querySelector<HTMLInputElement>('#gradient-b'),angle=document.querySelector<HTMLInputElement>('#gradient-angle'),preview=document.querySelector<HTMLElement>('#gradient-preview'),css=document.querySelector<HTMLInputElement>('#gradient-css'),out=document.querySelector<HTMLOutputElement>('#angle-value'),error=document.querySelector<HTMLElement>('#gradient-error'),copy=document.querySelector<HTMLButtonElement>('#copy-gradient');
function update(){const ca=a?.value.trim().toUpperCase(),cb=b?.value.trim().toUpperCase(),deg=Number(angle?.value||120);if(!parseHex(ca||'')||!parseHex(cb||'')){if(error)error.textContent='Enter valid 3-digit or 6-digit HEX colors.';return;}const value=`linear-gradient(${deg}deg, ${ca}, ${cb})`;if(preview)preview.style.background=value;if(css)css.value=value;if(out)out.value=`${deg}°`;if(error)error.textContent='';} [a,b,angle].forEach(el=>el?.addEventListener('input',update));copy?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(css?.value||'');if(copy){copy.textContent='Copied!';setTimeout(()=>copy.textContent='Copy CSS',1200);}}catch{if(error)error.textContent='Clipboard unavailable; select the CSS output manually.';}});update();
</script>
