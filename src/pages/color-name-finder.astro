---
import BaseLayout from '../layouts/BaseLayout.astro'; import { NAMED_COLORS } from '../data/colors';
---
<BaseLayout title="Color Name Finder — Find a Name for a HEX Color" description="Enter a HEX color code to find the closest color name in a curated reference list. Explore named colors and their values."><div class="container"><div class="page-hero"><div class="breadcrumbs"><a href="/">Home</a> / Color Name Finder</div><span class="eyebrow">Color reference</span><h1>Color Name Finder</h1><p>Enter a HEX value to find the closest named color in our curated reference list. The closest name is an approximation, not an official paint name.</p></div><div class="converter-card"><div class="field"><label for="name-hex">HEX color</label><input id="name-hex" value="#6C5CE7" /></div><div class="result-panel"><div class="result-swatch" id="name-swatch" style="background:#6C5CE7"></div><div class="result-values"><span class="eyebrow">CLOSEST LISTED COLOR</span><h3 id="nearest-name">Blue Violet</h3><strong id="nearest-hex">#8A2BE2</strong><p class="muted" id="name-note">Closest match in the included reference set.</p></div></div><p id="name-error" class="scanner-message" role="status"></p></div><section class="section"><div class="section-heading"><div><span class="eyebrow">Browse reference colors</span><h2>Named color examples</h2></div></div><div class="color-reference-grid">{NAMED_COLORS.map(c=><div class="color-reference"><div class="color-reference-swatch" style={`background:${c.hex}`}></div><div class="color-reference-body"><strong>{c.name}</strong><code>{c.hex}</code></div></div>)}</div></section></div></BaseLayout>
<script>
import { parseHex, rgbDistance } from '../lib/color'; import { NAMED_COLORS } from '../data/colors';
const input=document.querySelector<HTMLInputElement>('#name-hex');const swatch=document.querySelector<HTMLElement>('#name-swatch');const name=document.querySelector<HTMLElement>('#nearest-name');const hex=document.querySelector<HTMLElement>('#nearest-hex');const error=document.querySelector<HTMLElement>('#name-error');
function update(){const rgb=parseHex(input?.value||'');if(!rgb){if(error)error.textContent='Enter a valid 3-digit or 6-digit HEX value.';return;}let best=NAMED_COLORS[0],distance=Infinity;for(const item of NAMED_COLORS){const c=parseHex(item.hex);if(!c)continue;const d=rgbDistance(rgb,c);if(d<distance){distance=d;best=item;}}if(name)name.textContent=best.name;if(hex)hex.textContent=best.hex;if(swatch)swatch.style.background=input?.value||best.hex;if(error)error.textContent='';}
input?.addEventListener('input',update);update();
</script>
