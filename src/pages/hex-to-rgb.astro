---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="HEX to RGB Converter — Convert Hex Color Codes" description="Convert a HEX color code to RGB and HSL instantly. Enter a 3-digit or 6-digit HEX value and view a live color preview."><div class="container"><div class="page-hero"><div class="breadcrumbs"><a href="/">Home</a> / HEX to RGB</div><span class="eyebrow">Color format converter</span><h1>HEX to RGB Converter</h1><p>Enter a HEX color code to see its RGB channels, HSL values and color preview.</p></div><div class="converter-card"><div class="field"><label for="hex-input">HEX color</label><input id="hex-input" value="#6C5CE7" placeholder="#6C5CE7" autocomplete="off" /></div><div id="hex-preview" class="color-strip"><span style="background:#6C5CE7"></span></div><div class="form-row"><div class="field"><label>RGB</label><input id="rgb-output" readonly value="108, 92, 231" /></div><div class="field"><label>HSL</label><input id="hsl-output" readonly value="248°, 74%, 63%" /></div></div><p id="hex-error" class="scanner-message" role="status"></p><button id="copy-rgb" class="button button-primary" type="button">Copy RGB</button></div><article class="prose"><h2>What is a HEX color code?</h2><p>A HEX color code is a hexadecimal way to represent red, green and blue channel values. A common six-digit form uses two hexadecimal digits for each channel, such as <code>#6C5CE7</code>.</p><h2>How to convert HEX to RGB</h2><p>Remove the hash symbol, split the six digits into three pairs, then convert each pair from base 16 to a decimal number between 0 and 255. Use the converter above for an instant result.</p><h2>Related tools</h2><p>Try the <a href="/rgb-to-hex/">RGB to HEX converter</a>, <a href="/color-identifier/">color identifier</a> or <a href="/color-name-finder/">color name finder</a>.</p></article></div></BaseLayout>
<script>
import { parseHex, getColorResult } from '../lib/color';
const input=document.querySelector<HTMLInputElement>('#hex-input'); const rgb=document.querySelector<HTMLInputElement>('#rgb-output'); const hsl=document.querySelector<HTMLInputElement>('#hsl-output'); const preview=document.querySelector<HTMLElement>('#hex-preview'); const error=document.querySelector<HTMLElement>('#hex-error'); const copy=document.querySelector<HTMLButtonElement>('#copy-rgb');
function update(){const parsed=parseHex(input?.value||'');if(!parsed){if(error)error.textContent='Enter a valid 3-digit or 6-digit HEX value, such as #6C5CE7.';if(rgb)rgb.value='';if(hsl)hsl.value='';return;}const c=getColorResult(parsed);if(error)error.textContent='';if(rgb)rgb.value=`${c.rgb.r}, ${c.rgb.g}, ${c.rgb.b}`;if(hsl)hsl.value=`${c.hsl.h}°, ${c.hsl.s}%, ${c.hsl.l}%`;if(preview)preview.style.background=c.hex;}
input?.addEventListener('input',update);copy?.addEventListener('click',async()=>{if(rgb?.value)await navigator.clipboard.writeText(`rgb(${rgb.value})`);if(copy){copy.textContent='Copied!';setTimeout(()=>copy.textContent='Copy RGB',1200);}});update();
</script>
