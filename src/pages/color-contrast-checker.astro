---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Color Contrast Checker — Check WCAG Text Contrast" description="Check the contrast ratio between foreground text and a background color. Review WCAG AA and AAA contrast thresholds for accessible design."><div class="container"><div class="page-hero"><div class="breadcrumbs"><a href="/">Home</a> / Color Contrast Checker</div><span class="eyebrow">Accessibility tool</span><h1>Color Contrast Checker</h1><p>Compare text and background colors to estimate WCAG contrast compliance for readable interfaces.</p></div><div class="converter-card"><div class="form-row"><div class="field"><label for="foreground">Text color (HEX)</label><input id="foreground" value="#17152B" /></div><div class="field"><label for="background">Background color (HEX)</label><input id="background" value="#FFFFFF" /></div></div><div id="contrast-preview" class="info-card" style="margin-top:16px;background:#FFFFFF;color:#17152B"><h3>Sample text preview</h3><p>The quick brown fox jumps over the lazy dog.</p><small>Use this preview to inspect the selected foreground and background colors.</small></div><div class="converter-output"><strong id="contrast-ratio">17.2:1</strong><p id="contrast-status" class="muted">Calculating contrast…</p><div id="contrast-badges"></div></div><p id="contrast-error" class="scanner-message" role="status"></p></div><article class="prose"><h2>WCAG contrast thresholds</h2><ul><li>AA normal text: at least 4.5:1.</li><li>AA large text: at least 3:1.</li><li>AAA normal text: at least 7:1.</li><li>AAA large text: at least 4.5:1.</li></ul><p>Large text generally means at least 18pt regular or 14pt bold. Contrast is one part of accessibility; do not rely on color alone to communicate meaning.</p></article></div></BaseLayout>
<script>
import { parseHex, contrastRatio } from '../lib/color';
const fg=document.querySelector<HTMLInputElement>('#foreground'),bg=document.querySelector<HTMLInputElement>('#background'),preview=document.querySelector<HTMLElement>('#contrast-preview'),ratio=document.querySelector<HTMLElement>('#contrast-ratio'),status=document.querySelector<HTMLElement>('#contrast-status'),badges=document.querySelector<HTMLElement>('#contrast-badges'),error=document.querySelector<HTMLElement>('#contrast-error');
function update(){const a=parseHex(fg?.value||''),b=parseHex(bg?.value||'');if(!a||!b){if(error)error.textContent='Enter valid HEX values for both colors.';return;}const r=contrastRatio(a,b);if(preview){preview.style.color=fg!.value;preview.style.backgroundColor=bg!.value;}if(ratio)ratio.textContent=`${r.toFixed(2)}:1`;if(status)status.textContent=r>=7?'Passes WCAG AAA for normal text and AA for large text.':r>=4.5?'Passes WCAG AA for normal text and AAA for large text.':r>=3?'Passes WCAG AA for large text only.':'Does not meet WCAG AA text contrast thresholds.';if(badges)badges.textContent=`AA normal: ${r>=4.5?'Pass':'Fail'} · AA large: ${r>=3?'Pass':'Fail'} · AAA normal: ${r>=7?'Pass':'Fail'}`;if(error)error.textContent='';}
fg?.addEventListener('input',update);bg?.addEventListener('input',update);update();
</script>
