---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { NAMED_COLORS } from '../../data/colors'; import { parseHex, getColorResult } from '../../lib/color';
export function getStaticPaths(){return NAMED_COLORS.map(c=>({params:{slug:c.name.toLowerCase().replaceAll(' ','-')},props:{color:c}}));}
const {color}=Astro.props;const rgb=parseHex(color.hex)!;const result=getColorResult(rgb);
---
<BaseLayout title={`${color.name} Color — HEX ${color.hex}`} description={`Explore ${color.name}, a ${color.family.toLowerCase()} color. View its HEX, RGB and HSL values, description and practical design uses.`}><div class="container"><div class="page-hero"><div class="breadcrumbs"><a href="/">Home</a> / <a href="/color-names/">Color Names</a> / {color.name}</div><span class="eyebrow">{color.family} color reference</span><h1>{color.name} Color</h1><p>{color.description}</p></div><div class="converter-card"><div class="color-strip" style={`background:${color.hex};height:120px`}></div><div class="form-row"><div class="field"><label>HEX</label><input readonly value={color.hex}/></div><div class="field"><label>RGB</label><input readonly value={`${result.rgb.r}, ${result.rgb.g}, ${result.rgb.b}`}/></div><div class="field"><label>HSL</label><input readonly value={`${result.hsl.h}°, ${result.hsl.s}%, ${result.hsl.l}%`}/></div></div><p>{color.uses}</p><a class="button button-primary" href="/color-palette-generator/">Create a palette</a></div><article class="prose"><h2>About {color.name.toLowerCase()}</h2><p>{color.description} Its digital reference value in this library is <code>{color.hex}</code>. The RGB and HSL values are calculated from that HEX value.</p><h2>Where can this color be used?</h2><p>{color.uses} Always evaluate the color alongside nearby colors, typography, lighting and accessibility needs.</p><h2>Explore more</h2><ul><li><a href="/color-name-finder/">Find a color name from HEX</a></li><li><a href="/html-color-codes/">Browse HTML color codes</a></li><li><a href="/color-identifier/">Identify a color from a photo</a></li></ul></article></div></BaseLayout>
