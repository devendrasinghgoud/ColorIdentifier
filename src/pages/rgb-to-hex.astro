---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="RGB to HEX Converter — Convert RGB Values" description="Convert red, green and blue channel values into a HEX color code. Preview the color and copy the result for CSS or design work."><div class="container"><div class="page-hero"><div class="breadcrumbs"><a href="/">Home</a> / RGB to HEX</div><span class="eyebrow">Color format converter</span><h1>RGB to HEX Converter</h1><p>Enter red, green and blue values from 0 to 255 to generate a HEX color code.</p></div><div class="converter-card"><div class="form-row">{['r','g','b'].map((key,i)=><div class="field"><label for={`rgb-${key}`}>{key.toUpperCase()} channel</label><input id={`rgb-${key}`} type="number" min="0" max="255" value={[108,92,231][i]} /></div>)}</div><div id="rgb-preview" class="color-strip"><span style="background:#6C5CE7"></span></div><div class="field"><label for="hex-result">HEX result</label><input id="hex-result" readonly value="#6C5CE7" /></div><p id="rgb-error" class="scanner-message" role="status"></p><button id="copy-hex-result" class="button button-primary" type="button">Copy HEX</button></div><article class="prose"><h2>What do RGB values mean?</h2><p>RGB describes a screen color using red, green and blue light channels. Each channel is usually represented by an integer from 0 to 255 in common CSS notation.</p><h2>Related tools</h2><p>Use our <a href="/hex-to-rgb/">HEX to RGB converter</a> or <a href="/color-identifier/">camera color identifier</a>.</p></article></div></BaseLayout>
<script>
import { rgbToHex } from '../lib/color';
const fields=['r','g','b'].map(k=>document.querySelector<HTMLInputElement>(`#rgb-${k}`));const output=document.querySelector<HTMLInputElement>('#hex-result');const preview=document.querySelector<HTMLElement>('#rgb-preview');const error=document.querySelector<HTMLElement>('#rgb-error');const copy=document.querySelector<HTMLButtonElement>('#copy-hex-result');
function update(){const vals=fields.map(f=>Number(f?.value));if(vals.some(v=>!Number.isInteger(v)||v<0||v>255)){if(error)error.textContent='Each RGB channel must be a whole number from 0 to 255.';return;}const hex=rgbToHex({r:vals[0],g:vals[1],b:vals[2]});if(output)output.value=hex;if(preview)preview.style.background=hex;if(error)error.textContent='';}
fields.forEach(f=>f?.addEventListener('input',update));copy?.addEventListener('click',async()=>{if(output?.value)await navigator.clipboard.writeText(output.value);if(copy){copy.textContent='Copied!';setTimeout(()=>copy.textContent='Copy HEX',1200);}});update();
</script>
